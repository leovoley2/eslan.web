---
import Icon from './Icon.astro';
---

<section class="relative isolate overflow-hidden bg-brand-950">
  <video
    class="absolute inset-0 -z-10 h-full w-full object-cover object-center"
    src="/arena.mp4"
    poster="/atardecer.jpg"
    autoplay
    loop
    muted
    playsinline
    aria-hidden="true"
  ></video>
  <div class="absolute inset-0 -z-10 bg-gradient-to-r from-brand-950/85 via-brand-950/55 to-brand-950/20" aria-hidden="true"></div>

  <div class="container-site flex min-h-[78vh] flex-col justify-end pb-14 pt-24 sm:min-h-[82vh] sm:pb-20 lg:justify-center lg:pb-24">
    <div class="max-w-2xl">
      <p class="eyebrow-light">Escuela de vóley playa · Lima</p>
      <h1 class="mt-4 text-4xl font-extrabold leading-[1.05] text-white sm:text-5xl lg:text-6xl">
        Aprende y compite en la arena con coaches FIVB
      </h1>
      <p class="mt-5 max-w-xl text-base leading-relaxed text-white/75 sm:text-lg">
        Entrenamientos grupales y personalizados en Chorrillos y Surco, para todos los niveles. Tu primera clase es gratis.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="#reservas" class="btn-accent">
          Reservar clase <Icon name="arrow-right" class="h-4 w-4" />
        </a>
        <a href="#planes" class="btn-outline-light">Ver planes y precios</a>
      </div>
    </div>

    <dl class="mt-14 grid max-w-2xl grid-cols-3 gap-6 border-t border-white/15 pt-6">
      <div>
        <dt class="text-xs text-white/60 sm:text-sm">Atletas activos</dt>
        <dd class="mt-1 font-display text-2xl font-extrabold text-white sm:text-3xl">500+</dd>
      </div>
      <div>
        <dt class="text-xs text-white/60 sm:text-sm">Años de experiencia</dt>
        <dd class="mt-1 font-display text-2xl font-extrabold text-white sm:text-3xl">5+</dd>
      </div>
      <div>
        <dt class="text-xs text-white/60 sm:text-sm">Sedes en Lima</dt>
        <dd class="mt-1 font-display text-2xl font-extrabold text-white sm:text-3xl">2</dd>
      </div>
    </dl>
  </div>
</section>
