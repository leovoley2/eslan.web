---
interface Props {
    title: string
    class?: string
}
const {title} = Astro.props
---



<article class={`
    ${Astro.props.class}
    relative rounded-3xl
    backdrop-blur-xl bg-white/5
    border border-white/20
    shadow-[0_8px_32px_0_rgba(31,38,135,0.07)]
    hover:shadow-[0_8px_32px_0_rgba(78,178,229,0.3)]
    transition-all duration-500 hover:-translate-y-2
    group overflow-hidden
`}>
    <div class="
    absolute z-10 bottom-0 top-0 w-full h-full
    bg-gradient-to-t from-gray-900/95 via-gray-900/40 to-transparent
    pointer-events-none
    "></div>
<div class=" relative select-none flex flex-col gap-2 p-8 text-lg z-20 justify-end h-full">
    <slot name="image"></slot>
    <h2 class="text-3xl sm:text-4xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-white to-arena-light mb-2">{title}</h2>
    <slot name="conten"></slot>
</div> 
</article>