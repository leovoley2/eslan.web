<!-- Modern Header with Glass Morphism -->
<header class="fixed top-0 left-0 right-0 z-50 bg-white/90 backdrop-blur-lg border-b border-gray-100/50 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16 lg:h-20">
            <!-- Logo -->
            <div class="flex-shrink-0">
                <a href="/" class="flex items-center group">
                    <img src="/Principal.svg" alt="Arena voleibol club" class="h-8 lg:h-10 w-auto transition-transform duration-300 group-hover:scale-105">
                </a>
            </div>

            <!-- Desktop Navigation -->
            <nav class="hidden md:flex items-center space-x-1 lg:space-x-2">
                <a href="/" 
                   class="nav-link relative px-3 lg:px-4 py-2 text-sm lg:text-base font-medium text-gray-700 hover:text-[#ffb919] transition-all duration-300 group">
                    <span class="relative z-10">Inicio</span>
                    <div class="absolute inset-0 bg-gradient-to-r from-[#ffb919]/10 to-[#01577a]/10 rounded-lg scale-0 group-hover:scale-100 transition-transform duration-300"></div>
                </a>
                
                <a href="/nosotros" 
                   class="nav-link relative px-3 lg:px-4 py-2 text-sm lg:text-base font-medium text-gray-700 hover:text-[#ffb919] transition-all duration-300 group">
                    <span class="relative z-10">Nosotros</span>
                    <div class="absolute inset-0 bg-gradient-to-r from-[#ffb919]/10 to-[#01577a]/10 rounded-lg scale-0 group-hover:scale-100 transition-transform duration-300"></div>
                </a>
                
                <a href="/servicios" 
                   class="nav-link relative px-3 lg:px-4 py-2 text-sm lg:text-base font-medium text-gray-700 hover:text-[#ffb919] transition-all duration-300 group">
                    <span class="relative z-10">Servicios</span>
                    <div class="absolute inset-0 bg-gradient-to-r from-[#ffb919]/10 to-[#01577a]/10 rounded-lg scale-0 group-hover:scale-100 transition-transform duration-300"></div>
                </a>
                
                <a href="/contacto" 
                   class="nav-link relative px-3 lg:px-4 py-2 text-sm lg:text-base font-medium text-gray-700 hover:text-[#ffb919] transition-all duration-300 group">
                    <span class="relative z-10">Contacto</span>
                    <div class="absolute inset-0 bg-gradient-to-r from-[#ffb919]/10 to-[#01577a]/10 rounded-lg scale-0 group-hover:scale-100 transition-transform duration-300"></div>
                </a>
            </nav>

            <!-- CTA Button -->
            <div class="hidden md:block">
                <a href="/aprendo" 
                   class="inline-flex items-center px-4 lg:px-6 py-2 lg:py-2.5 bg-gradient-to-r from-[#ffb919] to-[#01577a] text-white text-sm lg:text-base font-semibold rounded-full hover:shadow-lg hover:shadow-[#ffb919]/25 transform hover:scale-105 transition-all duration-300">
                    <span>Aprende Jugando</span>
                    <svg class="ml-2 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                    </svg>
                </a>
            </div>

            <!-- Mobile menu button -->
            <div class="md:hidden">
                <button id="mobile-menu-button" 
                        class="relative inline-flex items-center justify-center p-2 rounded-md text-gray-700 hover:text-[#ffb919] hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-[#ffb919] transition-colors duration-200">
                    <span class="sr-only">Abrir menú principal</span>
                    <!-- Hamburger icon -->
                    <div class="hamburger-lines">
                        <span class="line line1 block w-6 h-0.5 bg-current transition-all duration-300"></span>
                        <span class="line line2 block w-6 h-0.5 bg-current mt-1.5 transition-all duration-300"></span>
                        <span class="line line3 block w-6 h-0.5 bg-current mt-1.5 transition-all duration-300"></span>
                    </div>
                </button>
            </div>
        </div>
    </div>

    <!-- Mobile menu -->
    <div id="mobile-menu" class="md:hidden hidden">
        <div class="bg-white/95 backdrop-blur-lg border-t border-gray-100/50">
            <div class="px-4 pt-4 pb-6 space-y-2">
                <a href="/" 
                   class="block px-4 py-3 text-base font-medium text-gray-700 hover:text-[#ffb919] hover:bg-gradient-to-r hover:from-[#ffb919]/10 hover:to-[#01577a]/10 rounded-lg transition-all duration-300">
                    Inicio
                </a>
                
                <a href="/nosotros" 
                   class="block px-4 py-3 text-base font-medium text-gray-700 hover:text-[#ffb919] hover:bg-gradient-to-r hover:from-[#ffb919]/10 hover:to-[#01577a]/10 rounded-lg transition-all duration-300">
                    Nosotros
                </a>
                
                <a href="/servicios" 
                   class="block px-4 py-3 text-base font-medium text-gray-700 hover:text-[#ffb919] hover:bg-gradient-to-r hover:from-[#ffb919]/10 hover:to-[#01577a]/10 rounded-lg transition-all duration-300">
                    Servicios
                </a>
                
                <a href="/contacto" 
                   class="block px-4 py-3 text-base font-medium text-gray-700 hover:text-[#ffb919] hover:bg-gradient-to-r hover:from-[#ffb919]/10 hover:to-[#01577a]/10 rounded-lg transition-all duration-300">
                    Contacto
                </a>
                
                <div class="pt-4">
                    <a href="/aprendo" 
                       class="block w-full text-center px-4 py-3 bg-gradient-to-r from-[#ffb919] to-[#01577a] text-white font-semibold rounded-lg hover:shadow-lg transform hover:scale-105 transition-all duration-300">
                        Aprende Jugando
                    </a>
                </div>
            </div>
        </div>
    </div>
</header>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const mobileMenuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');
    const hamburgerLines = document.querySelectorAll('.hamburger-lines .line');

    if (mobileMenuButton && mobileMenu) {
        mobileMenuButton.addEventListener('click', function() {
            const isOpen = !mobileMenu.classList.contains('hidden');
            
            if (isOpen) {
                // Close menu
                mobileMenu.classList.add('hidden');
                // Reset hamburger
                (hamburgerLines[0] as HTMLElement).style.transform = 'rotate(0deg) translateY(0)';
                (hamburgerLines[1] as HTMLElement).style.opacity = '1';
                (hamburgerLines[2] as HTMLElement).style.transform = 'rotate(0deg) translateY(0)';
            } else {
                // Open menu
                mobileMenu.classList.remove('hidden');
                // Animate to X
                (hamburgerLines[0] as HTMLElement).style.transform = 'rotate(45deg) translateY(8px)';
                (hamburgerLines[1] as HTMLElement).style.opacity = '0';
                (hamburgerLines[2] as HTMLElement).style.transform = 'rotate(-45deg) translateY(-8px)';
            }
        });

        // Close menu when clicking on links
        const mobileLinks = mobileMenu.querySelectorAll('a');
        mobileLinks.forEach(link => {
            link.addEventListener('click', () => {
                mobileMenu.classList.add('hidden');
                // Reset hamburger
                (hamburgerLines[0] as HTMLElement).style.transform = 'rotate(0deg) translateY(0)';
                (hamburgerLines[1] as HTMLElement).style.opacity = '1';
                (hamburgerLines[2] as HTMLElement).style.transform = 'rotate(0deg) translateY(0)';
            });
        });
    }

    // Add scroll effect to header
    let lastScrollY = window.scrollY;
    const header = document.querySelector('header');
    
    window.addEventListener('scroll', () => {
        const currentScrollY = window.scrollY;
        
        if (currentScrollY > 10) {
            header?.classList.add('bg-white/95', 'shadow-md');
            header?.classList.remove('bg-white/90');
        } else {
            header?.classList.add('bg-white/90');
            header?.classList.remove('bg-white/95', 'shadow-md');
        }
        
        lastScrollY = currentScrollY;
    });
});
</script>

<style>
/* Additional styles for modern header */
.nav-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 50%;
    width: 0;
    height: 2px;
    background: linear-gradient(90deg, #ffb919, #01577a);
    transition: all 0.3s ease;
    transform: translateX(-50%);
}

.nav-link:hover::after {
    width: 80%;
}

/* Smooth transitions for mobile menu */
#mobile-menu {
    transition: all 0.3s ease-in-out;
}

/* Hamburger animation */
.hamburger-lines .line {
    transition: all 0.3s cubic-bezier(0.68, -0.55, 0.265, 1.55);
}

/* Improve glass morphism effect */
header {
    transition: all 0.3s ease;
}

/* Active page indicator */
.nav-link[aria-current="page"] {
    color: #ffb919;
    font-weight: 600;
}

.nav-link[aria-current="page"]::after {
    width: 80%;
}
</style>