}

/* Enhanced Mobile Menu Styles */
#mobile-menu {
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    max-height: calc(100vh - 3.5rem);
    max-height: calc(var(--vh, 1vh) * 100 - 3.5rem);
}

/* Mobile menu animations */
.mobile-nav-link {
    position: relative;
    overflow: hidden;
}

.mobile-nav-link::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
