    <!-- Enhanced Mobile menu -->
    <div id="mobile-menu" class="md:hidden hidden transform transition-all duration-300 ease-in-out">
        <div class="bg-white/95 backdrop-blur-lg border-t border-gray-100/50 shadow-lg">
            <div class="px-4 pt-6 pb-8 space-y-1 max-h-screen overflow-y-auto">
                <a href="/" 
                   class="mobile-nav-link block px-4 py-4 text-lg font-medium text-gray-700 hover:text-[#ffb919] hover:bg-gradient-to-r hover:from-[#ffb919]/10 hover:to-[#01577a]/10 rounded-xl transition-all duration-300 touch-manipulation"
                   data-mobile-link>
                    <div class="flex items-center justify-between">
                        <span>Inicio</span>
                        <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                        </svg>
                    </div>
                </a>
                
                <a href="/nosotros" 
                   class="mobile-nav-link block px-4 py-4 text-lg font-medium text-gray-700 hover:text-[#ffb919] hover:bg-gradient-to-r hover:from-[#ffb919]/10 hover:to-[#01577a]/10 rounded-xl transition-all duration-300 touch-manipulation"
                   data-mobile-link>
                    <div class="flex items-center justify-between">
                        <span>Nosotros</span>
                        <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                        </svg>
                    </div>
                </a>
                
                <a href="/servicios" 
                   class="mobile-nav-link block px-4 py-4 text-lg font-medium text-gray-700 hover:text-[#ffb919] hover:bg-gradient-to-r hover:from-[#ffb919]/10 hover:to-[#01577a]/10 rounded-xl transition-all duration-300 touch-manipulation"
                   data-mobile-link>
                    <div class="flex items-center justify-between">
                        <span>Servicios</span>
                        <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                        </svg>
                    </div>
                </a>
                
                <a href="/contacto" 
                   class="mobile-nav-link block px-4 py-4 text-lg font-medium text-gray-700 hover:text-[#ffb919] hover:bg-gradient-to-r hover:from-[#ffb919]/10 hover:to-[#01577a]/10 rounded-xl transition-all duration-300 touch-manipulation"
                   data-mobile-link>
                    <div class="flex items-center justify-between">
                        <span>Contacto</span>
                        <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                        </svg>
                    </div>
                </a>
                
                <div class="pt-6 border-t border-gray-200 mt-6">
                    <a href="/aprendo" 
                       class="block w-full text-center px-6 py-4 bg-gradient-to-r from-[#ffb919] to-[#01577a] text-white text-lg font-semibold rounded-xl hover:shadow-lg transform active:scale-95 transition-all duration-300 touch-manipulation"
                       data-mobile-link>
                        <div class="flex items-center justify-center space-x-2">
                            <span>Aprende Jugando</span>
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                            </svg>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </div>
</header>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const mobileMenuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');
    const hamburgerLines = document.querySelectorAll('.hamburger-lines .line');
    const mobileLinks = document.querySelectorAll('[data-mobile-link]');
    let isMenuOpen = false;

    // Enhanced mobile menu functionality
    if (mobileMenuButton && mobileMenu) {
        // Toggle menu
        mobileMenuButton.addEventListener('click', function(e) {
            e.preventDefault();
            toggleMobileMenu();
        });

        // Close menu when clicking outside
        document.addEventListener('click', function(e) {
            if (isMenuOpen && !mobileMenu.contains(e.target as Node) && !mobileMenuButton.contains(e.target as Node)) {
                closeMobileMenu();
            }
        });

        // Close menu on escape key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape' && isMenuOpen) {
                closeMobileMenu();
                mobileMenuButton.focus();
            }
        });

        // Close menu when clicking on mobile links
        mobileLinks.forEach(link => {
            link.addEventListener('click', () => {
                setTimeout(() => closeMobileMenu(), 150);
            });
        });

        // Touch gesture support for mobile menu
        let startY = 0;
        mobileMenu.addEventListener('touchstart', function(e) {
            startY = e.touches[0].clientY;
        }, { passive: true });

        mobileMenu.addEventListener('touchmove', function(e) {
            const currentY = e.touches[0].clientY;
            const diff = startY - currentY;
            
            // Close menu on swipe up
            if (diff > 50 && isMenuOpen) {
                closeMobileMenu();
            }
        }, { passive: true });

        function toggleMobileMenu() {
            if (isMenuOpen) {
                closeMobileMenu();
            } else {
                openMobileMenu();
            }
        }

        function openMobileMenu() {
            isMenuOpen = true;
            mobileMenu.classList.remove('hidden');
            mobileMenuButton.setAttribute('aria-expanded', 'true');
            
            // Animate hamburger to X
            setTimeout(() => {
                (hamburgerLines[0] as HTMLElement).style.transform = 'rotate(45deg) translateY(8px)';
                (hamburgerLines[1] as HTMLElement).style.opacity = '0';
                (hamburgerLines[2] as HTMLElement).style.transform = 'rotate(-45deg) translateY(-8px)';
            }, 50);

            // Prevent body scroll
            document.body.style.overflow = 'hidden';
            
            // Add slide down animation
            mobileMenu.style.transform = 'translateY(-100%)';
            requestAnimationFrame(() => {
                mobileMenu.style.transform = 'translateY(0)';
            });
        }

        function closeMobileMenu() {
            isMenuOpen = false;
            mobileMenuButton.setAttribute('aria-expanded', 'false');
            
            // Reset hamburger
            (hamburgerLines[0] as HTMLElement).style.transform = 'rotate(0deg) translateY(0)';
            (hamburgerLines[1] as HTMLElement).style.opacity = '1';
            (hamburgerLines[2] as HTMLElement).style.transform = 'rotate(0deg) translateY(0)';

            // Add slide up animation
            mobileMenu.style.transform = 'translateY(-100%)';
            
            setTimeout(() => {
                mobileMenu.classList.add('hidden');
                mobileMenu.style.transform = 'translateY(0)';
                // Re-enable body scroll
                document.body.style.overflow = '';
            }, 300);
        }
    }

    // Enhanced scroll effect for mobile
    let lastScrollY = window.scrollY;
    let ticking = false;
    const header = document.querySelector('header');
    
    function updateHeader() {
        const currentScrollY = window.scrollY;
        
        if (currentScrollY > 20) {
            header?.classList.add('bg-white/95', 'shadow-md');
            header?.classList.remove('bg-white/90');
        } else {
            header?.classList.add('bg-white/90');
            header?.classList.remove('bg-white/95', 'shadow-md');
        }
        
        // Hide header on scroll down, show on scroll up (mobile only)
        if (window.innerWidth < 768) {
            if (currentScrollY > lastScrollY && currentScrollY > 100 && !isMenuOpen) {
                header?.classList.add('-translate-y-full');
            } else {
                header?.classList.remove('-translate-y-full');
            }
        }
        
        lastScrollY = currentScrollY;
        ticking = false;
    }

    function requestTick() {
        if (!ticking) {
            requestAnimationFrame(updateHeader);
            ticking = true;
        }
    }

    window.addEventListener('scroll', requestTick, { passive: true });

    // Optimize for mobile performance
    if ('ontouchstart' in window) {
        // Add touch-specific optimizations
        document.body.classList.add('touch-device');
        
        // Improve scroll performance on mobile
        const passiveEvents = ['touchstart', 'touchmove', 'touchend'];
        passiveEvents.forEach(event => {
            document.addEventListener(event, function() {}, { passive: true });
        });
    }

    // Handle orientation change
    window.addEventListener('orientationchange', function() {
        if (isMenuOpen) {
            // Close menu on orientation change
            isMenuOpen = false;
            mobileMenuButton.setAttribute('aria-expanded', 'false');
            
            // Reset hamburger
            (hamburgerLines[0] as HTMLElement).style.transform = 'rotate(0deg) translateY(0)';
            (hamburgerLines[1] as HTMLElement).style.opacity = '1';
            (hamburgerLines[2] as HTMLElement).style.transform = 'rotate(0deg) translateY(0)';

            mobileMenu.classList.add('hidden');
            document.body.style.overflow = '';
        }
        
        // Recalculate heights after orientation change
        setTimeout(() => {
            const vh = window.innerHeight * 0.01;
            document.documentElement.style.setProperty('--vh', `${vh}px`);
        }, 100);
    });

    // Set initial viewport height
    const vh = window.innerHeight * 0.01;
    document.documentElement.style.setProperty('--vh', `${vh}px`);
});
</script>

<style>
/* Enhanced Mobile Navigation Styles */
header {
    transition: all 0.3s ease, transform 0.3s ease;
}

.nav-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 50%;
    width: 0;
    height: 2px;
    background: linear-gradient(90deg, #ffb919, #01577a);
