---
import Icon from './Icon.astro';

interface Props {
  hideForm?: boolean;
}
const { hideForm = false } = Astro.props;

const nav = [
  { href: '/', label: 'Inicio' },
  { href: '/nosotros', label: 'Nosotros' },
  { href: '/servicios', label: 'Servicios' },
  { href: '/aprendo', label: 'Aprende jugando' },
  { href: '/niveles', label: 'Niveles' },
  { href: '/clinicas', label: 'Clínicas' },
  { href: '/contacto', label: 'Contacto' },
];
---

<footer class="bg-brand-900 text-white">

  {/* ── Formulario rápido (oculto en la página de contacto) ── */}
  {!hideForm && (
    <div class="border-b border-white/10">
      <div class="container-site grid gap-10 py-16 sm:py-20 lg:grid-cols-[1fr_1.1fr] lg:gap-16">
        <div>
          <p class="eyebrow-light">¿Listo para jugar?</p>
          <h2 class="mt-3 text-3xl font-extrabold leading-tight text-white sm:text-4xl">Escríbenos y te contactamos</h2>
          <p class="mt-4 max-w-md text-base leading-relaxed text-white/65">
            Déjanos tus datos y un entrenador te responderá en menos de 24 horas.
          </p>
        </div>

        <div>
          <form id="footerContactForm" class="grid gap-4" novalidate>
            <div class="grid gap-4 sm:grid-cols-2">
              <div>
                <label for="f-name" class="sr-only">Nombre</label>
                <input type="text" id="f-name" name="name" placeholder="Tu nombre" required autocomplete="name" class="footer-input" />
                <span class="f-error" id="f-name-err"></span>
              </div>
              <div>
                <label for="f-email" class="sr-only">Correo electrónico</label>
                <input type="email" id="f-email" name="email" placeholder="tu@email.com" required autocomplete="email" class="footer-input" />
                <span class="f-error" id="f-email-err"></span>
              </div>
            </div>
            <div>
              <label for="f-message" class="sr-only">Mensaje</label>
              <textarea id="f-message" name="message" rows="3" placeholder="¿En qué podemos ayudarte?" required class="footer-input resize-none"></textarea>
              <span class="f-error" id="f-message-err"></span>
            </div>
            <div>
              <button type="submit" id="footer-submit-btn" class="btn-accent">
                <span class="btn-label">Enviar mensaje</span>
                <Icon name="send" class="h-4 w-4" />
              </button>
            </div>
          </form>

          <div id="footer-success" class="hidden rounded-xl border border-white/15 bg-white/5 p-6" role="status">
            <p class="font-display text-lg font-bold text-white">¡Mensaje recibido!</p>
            <p class="mt-1 text-sm text-white/65">Te responderemos muy pronto.</p>
          </div>
        </div>
      </div>
    </div>
  )}

  {/* ── Pie principal ── */}
  <div class="container-site py-14">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1.2fr_1fr]">

      <div>
        <img src="/logo-arena.svg" alt="Arena Voleibol Club" class="h-12 w-auto brightness-0 invert" width="73" height="48" loading="lazy" />
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-white/60">
          Escuela de voleibol de playa en Lima. Entrenamiento para todos los niveles con coaches certificados FIVB.
        </p>
        <div class="mt-5 flex gap-2">
          <a href="https://www.instagram.com/arena_voleibolclub" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="flex h-10 w-10 items-center justify-center rounded-full border border-white/15 text-white/70 transition-colors hover:border-white/40 hover:text-white">
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          </a>
          <a href="https://www.facebook.com/p/Arena-voleibol-club-100092486123346/" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="flex h-10 w-10 items-center justify-center rounded-full border border-white/15 text-white/70 transition-colors hover:border-white/40 hover:text-white">
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
        </div>
      </div>

      <div>
        <h2 class="text-sm font-semibold text-white">Navegación</h2>
        <ul class="mt-4 space-y-2.5 text-sm">
          {nav.map((item) => (
            <li><a href={item.href} class="text-white/60 transition-colors hover:text-white">{item.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h2 class="text-sm font-semibold text-white">Contacto</h2>
        <ul class="mt-4 space-y-3 text-sm text-white/60">
          <li>
            <a href="tel:+51929418895" class="inline-flex items-center gap-2.5 transition-colors hover:text-white">
              <Icon name="phone" class="h-4 w-4 flex-none" /> 929 418 895
            </a>
          </li>
          <li>
            <a href="mailto:arenavoleibolclub@gmail.com" class="inline-flex items-center gap-2.5 break-all transition-colors hover:text-white">
              <Icon name="mail" class="h-4 w-4 flex-none" /> arenavoleibolclub@gmail.com
            </a>
          </li>
          <li class="inline-flex items-center gap-2.5">
            <Icon name="map-pin" class="h-4 w-4 flex-none" /> Chorrillos y Surco, Lima
          </li>
        </ul>
      </div>

      <div>
        <h2 class="text-sm font-semibold text-white">Horarios</h2>
        <dl class="mt-4 space-y-4 text-sm">
          <div>
            <dt class="font-medium text-white/85">Chorrillos</dt>
            <dd class="mt-0.5 text-white/60">Lun · Mié · Vie · Sáb<br />6:30 – 8:30 a. m.</dd>
          </div>
          <div>
            <dt class="font-medium text-white/85">Surco</dt>
            <dd class="mt-0.5 text-white/60">Mar · Jue<br />6:00 – 8:00 p. m.</dd>
          </div>
        </dl>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-4 border-t border-white/10 pt-6 text-sm text-white/45 sm:flex-row sm:items-center sm:justify-between">
      <p>© {new Date().getFullYear()} Arena Voleibol Club. Todos los derechos reservados.</p>
      <a href="/#reservas" class="inline-flex items-center gap-1.5 font-medium text-white/70 transition-colors hover:text-white">
        Reserva tu clase <Icon name="arrow-right" class="h-4 w-4" />
      </a>
    </div>
  </div>
</footer>

<script>
// ── Formulario del pie con EmailJS ──
(function() {
  const form = document.getElementById('footerContactForm') as HTMLFormElement | null;
  if (!form) return;

  const s = document.createElement('script');
  s.src = 'https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js';
  s.onload = () => { (window as any).emailjs?.init('dG-vxHRYY4yYtgoJn'); };
  document.head.appendChild(s);

  const submitBtn = document.getElementById('footer-submit-btn') as HTMLButtonElement | null;
  const successDiv = document.getElementById('footer-success');

  function setError(id: string, msg: string) {
    const el = document.getElementById(id);
    if (el) el.textContent = msg;
    const field = document.getElementById(id.replace('-err',''));
    field?.classList.toggle('f-invalid', !!msg);
    field?.setAttribute('aria-invalid', msg ? 'true' : 'false');
  }
  function clearErrors() {
    ['f-name-err','f-email-err','f-message-err'].forEach(id => setError(id, ''));
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    clearErrors();

    const emailjs = (window as any).emailjs;
    if (!emailjs) { setError('f-name-err', 'Servicio no disponible. Intenta más tarde.'); return; }

    const fd = new FormData(form);
    const name    = (fd.get('name')    as string ?? '').trim();
    const email   = (fd.get('email')   as string ?? '').trim();
    const message = (fd.get('message') as string ?? '').trim();

    let ok = true;
    if (!name || name.length < 2)                          { setError('f-name-err',    'Ingresa tu nombre.'); ok = false; }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email))        { setError('f-email-err',   'Ingresa un correo válido.'); ok = false; }
    if (!message || message.length < 10)                   { setError('f-message-err', 'Escribe al menos 10 caracteres.'); ok = false; }
    if (!ok) return;

    if (submitBtn) {
      submitBtn.disabled = true;
      const lbl = submitBtn.querySelector('.btn-label');
      if (lbl) lbl.textContent = 'Enviando…';
    }

    try {
      const result = await emailjs.send('service_fayk1hj', 'template_5e9osht', {
        from_name: name,
        reply_to:  email,
        message:   message,
        phone:     'No proporcionado',
        interest:  'Consulta general',
      });
      if (result.text === 'OK') {
        form.classList.add('hidden');
        successDiv?.classList.remove('hidden');
      } else { throw new Error(); }
    } catch {
      setError('f-message-err', 'No se pudo enviar. Escríbenos por WhatsApp.');
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        const lbl = submitBtn.querySelector('.btn-label');
        if (lbl) lbl.textContent = 'Enviar mensaje';
      }
    }
  });

  form.querySelectorAll('input, textarea').forEach(el => {
    el.addEventListener('input', clearErrors);
  });
})();
</script>

<style>
  .footer-input {
    display: block;
    width: 100%;
    border-radius: 0.5rem;
    border: 1px solid rgb(255 255 255 / 0.15);
    background: rgb(255 255 255 / 0.05);
    padding: 0.7rem 0.9rem;
    font-size: 1rem;
    color: #fff;
    transition: border-color 0.2s, background-color 0.2s;
  }
  .footer-input::placeholder { color: rgb(255 255 255 / 0.4); }
  .footer-input:focus {
    outline: none;
    border-color: #FFB919;
    background: rgb(255 255 255 / 0.08);
  }
  .footer-input.f-invalid { border-color: #F97066; }
  .f-error {
    display: block;
    margin-top: 0.35rem;
    font-size: 0.8rem;
    color: #FDA29B;
  }
  .f-error:empty { display: none; }
  @media (min-width: 640px) {
    .footer-input { font-size: 0.875rem; }
  }
</style>
