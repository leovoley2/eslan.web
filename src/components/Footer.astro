---
interface Props {
  hideForm?: boolean;
}
const { hideForm = false } = Astro.props;
---

<footer class="site-footer">

  {/* ── Contact Form Strip (hidden on contact page) ── */}
  {!hideForm && (
    <div class="footer-form-strip">
      <div class="footer-container">
        <div class="form-strip-inner">

          <div class="strip-left">
            <p class="strip-eyebrow">¿Listo para jugar?</p>
            <h2 class="strip-title">Escríbenos y<br/><span class="strip-accent">te contactamos</span></h2>
            <p class="strip-desc">Déjanos tus datos y un entrenador te responderá en menos de 24 h.</p>
          </div>

          <div class="strip-right">
            <form id="footerContactForm" class="footer-form" novalidate>
              <div class="footer-form-row">
                <div class="footer-field">
                  <input type="text" id="f-name" name="name" placeholder="Tu nombre" required autocomplete="name"/>
                  <span class="f-error" id="f-name-err"></span>
                </div>
                <div class="footer-field">
                  <input type="email" id="f-email" name="email" placeholder="tu@email.com" required autocomplete="email"/>
                  <span class="f-error" id="f-email-err"></span>
                </div>
              </div>
              <div class="footer-field">
                <textarea id="f-message" name="message" rows="3" placeholder="¿En qué podemos ayudarte?" required></textarea>
                <span class="f-error" id="f-message-err"></span>
              </div>
              <button type="submit" id="footer-submit-btn" class="footer-submit-btn">
                <span class="btn-label">Enviar mensaje</span>
                <svg class="btn-icon" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/>
                </svg>
              </button>
            </form>
            <div id="footer-success" class="footer-success hidden">
              <span class="fs-icon">🎉</span>
              <div>
                <strong>¡Mensaje recibido!</strong>
                <p>Te responderemos muy pronto.</p>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  )}

  {/* ── Main Footer ── */}
  <div class="footer-main">
    <div class="footer-container">
      <div class="footer-grid">

        {/* Brand */}
        <div class="footer-brand">
          <img src="/S-NoTagline.png" alt="Arena Voleibol Club" class="footer-logo"/>
          <p class="brand-tagline">El voleibol de playa más divertido de Lima. Únete a nuestra comunidad.</p>
          <div class="footer-socials">
            <a href="https://www.facebook.com/p/Arena-voleibol-club-100092486123346/" target="_blank" rel="noopener noreferrer" class="social-pill" aria-label="Facebook">
              <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              Facebook
            </a>
            <a href="https://www.instagram.com/arena_voleibolclub" target="_blank" rel="noopener noreferrer" class="social-pill" aria-label="Instagram">
              <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
              Instagram
            </a>
          </div>
        </div>

        {/* Links */}
        <div class="footer-links">
          <h4 class="links-title">Navegación</h4>
          <ul>
            <li><a href="/">Inicio</a></li>
            <li><a href="/nosotros">Nosotros</a></li>
            <li><a href="/servicios">Servicios</a></li>
            <li><a href="/niveles">Niveles</a></li>
            <li><a href="/contacto">Contacto</a></li>
          </ul>
        </div>

        {/* Contact info */}
        <div class="footer-links">
          <h4 class="links-title">Contacto</h4>
          <ul>
            <li>
              <a href="tel:+51929418895">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                929 418 895
              </a>
            </li>
            <li>
              <a href="mailto:arenavoleibolclub@gmail.com">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                arenavoleibolclub@gmail.com
              </a>
            </li>
            <li>
              <span class="contact-meta">
                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                Chorrillos &amp; Surco, Lima
              </span>
            </li>
          </ul>
        </div>

        {/* Schedule */}
        <div class="footer-links">
          <h4 class="links-title">Horarios</h4>
          <ul class="schedule-list">
            <li>
              <span class="sede-tag">Chorrillos</span>
              <span>Lun · Mié · Vie · Sáb<br/>6:30 - 8:30 AM</span>
            </li>
            <li>
              <span class="sede-tag">Surco</span>
              <span>Mar · Jue<br/>6:00 - 8:00 PM</span>
            </li>
          </ul>
        </div>

      </div>

      <div class="footer-bottom">
        <p class="footer-copy">© {new Date().getFullYear()} Arena Voleibol Club · Todos los derechos reservados.</p>
        <a href="https://wa.me/51929418895" target="_blank" rel="noopener noreferrer" class="footer-wa-btn">
          <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.124.549 4.122 1.514 5.857L.042 23.25A.75.75 0 00.75 24h.033l5.519-1.444A11.936 11.936 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.75a9.716 9.716 0 01-4.946-1.352l-.354-.211-3.67.961.978-3.572-.23-.368A9.713 9.713 0 012.25 12C2.25 6.615 6.615 2.25 12 2.25S21.75 6.615 21.75 12 17.385 21.75 12 21.75z"/></svg>
          WhatsApp directo
        </a>
      </div>
    </div>
  </div>

</footer>

<script>
// ── Footer EmailJS form ──
(function() {
  // Only run if form exists on page
  const form = document.getElementById('footerContactForm') as HTMLFormElement | null;
  if (!form) return;

  // Load EmailJS
  const s = document.createElement('script');
  s.src = 'https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js';
  s.onload = () => { (window as any).emailjs?.init('dG-vxHRYY4yYtgoJn'); };
  document.head.appendChild(s);

  const submitBtn = document.getElementById('footer-submit-btn') as HTMLButtonElement | null;
  const successDiv = document.getElementById('footer-success');

  function setError(id: string, msg: string) {
    const el = document.getElementById(id);
    if (el) el.textContent = msg;
    const field = document.getElementById(id.replace('-err',''));
    field?.classList.toggle('f-invalid', !!msg);
  }
  function clearErrors() {
    ['f-name-err','f-email-err','f-message-err'].forEach(id => setError(id, ''));
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    clearErrors();

    const emailjs = (window as any).emailjs;
    if (!emailjs) { setError('f-name-err', 'Servicio no disponible. Intenta más tarde.'); return; }

    const fd = new FormData(form);
    const name    = (fd.get('name')    as string ?? '').trim();
    const email   = (fd.get('email')   as string ?? '').trim();
    const message = (fd.get('message') as string ?? '').trim();

    let ok = true;
    if (!name || name.length < 2)                          { setError('f-name-err',    'Nombre inválido.'); ok = false; }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email))        { setError('f-email-err',   'Email inválido.'); ok = false; }
    if (!message || message.length < 10)                   { setError('f-message-err', 'Mínimo 10 caracteres.'); ok = false; }
    if (!ok) return;

    if (submitBtn) {
      submitBtn.disabled = true;
      const lbl = submitBtn.querySelector('.btn-label');
      if (lbl) lbl.textContent = 'Enviando…';
    }

    try {
      const result = await emailjs.send('service_fayk1hj', 'template_5e9osht', {
        from_name: name,
        reply_to:  email,
        message:   message,
        phone:     'No proporcionado',
        interest:  'Consulta general',
      });
      if (result.text === 'OK') {
        form.classList.add('hidden');
        successDiv?.classList.remove('hidden');
      } else { throw new Error(); }
    } catch {
      setError('f-message-err', 'Error al enviar. Escríbenos por WhatsApp.');
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        const lbl = submitBtn.querySelector('.btn-label');
        if (lbl) lbl.textContent = 'Enviar mensaje';
      }
    }
  });

  // Clear on input
  form.querySelectorAll('input, textarea').forEach(el => {
    el.addEventListener('input', clearErrors);
  });
})();
</script>

<style>
/* ── Variables ── */
:root {
  --fn: #01577a;
  --fn-dark: #023d55;
  --fa: #ffb919;
  --fw: #ffffff;
  --fg: #f8f9fa;
  --fgt: #6c757d;
  --fg8: #343a40;
}

/* ── Footer shell ── */
.site-footer {
  font-family: system-ui, sans-serif;
}

/* ═══════════════════════════════════
   FORM STRIP
═══════════════════════════════════ */
.footer-form-strip {
  background: linear-gradient(135deg, var(--fn-dark) 0%, var(--fn) 100%);
  padding: 4rem 1.5rem;
  position: relative;
  overflow: hidden;
}
.footer-form-strip::before {
  content: '';
  position: absolute;
  top: -120px; right: -120px;
  width: 350px; height: 350px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255,185,25,0.12) 0%, transparent 70%);
  pointer-events: none;
}

.footer-container {
  max-width: 1200px;
  margin: 0 auto;
}

.form-strip-inner {
  display: grid;
  grid-template-columns: 1fr 1.5fr;
  gap: 4rem;
  align-items: center;
}

/* Strip left */
.strip-eyebrow {
  display: inline-block;
  background: rgba(255,185,25,0.15);
  border: 1px solid rgba(255,185,25,0.35);
  color: var(--fa);
  padding: 0.3rem 0.9rem;
  border-radius: 999px;
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  margin-bottom: 1rem;
}
.strip-title {
  font-size: clamp(1.6rem, 2.5vw, 2.4rem);
  font-weight: 900;
  color: var(--fw);
  line-height: 1.15;
  margin-bottom: 0.85rem;
}
.strip-accent { color: var(--fa); }
.strip-desc {
  color: rgba(255,255,255,0.65);
  font-size: 0.95rem;
  line-height: 1.65;
  margin: 0;
}

/* Strip right — form */
.footer-form {
  display: flex;
  flex-direction: column;
  gap: 0.9rem;
}
.footer-form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.9rem;
}
.footer-field {
  display: flex;
  flex-direction: column;
}
.footer-field input,
.footer-field textarea {
  padding: 0.75rem 1rem;
  border-radius: 0.75rem;
  border: 2px solid rgba(255,255,255,0.15);
  background: rgba(255,255,255,0.08);
  color: var(--fw);
  font-size: 0.92rem;
  font-family: inherit;
  outline: none;
  transition: border-color 0.2s, background 0.2s;
  box-sizing: border-box;
  width: 100%;
}
.footer-field input::placeholder,
.footer-field textarea::placeholder {
  color: rgba(255,255,255,0.4);
}
.footer-field input:focus,
.footer-field textarea:focus {
  border-color: var(--fa);
  background: rgba(255,255,255,0.12);
}
.footer-field input.f-invalid,
.footer-field textarea.f-invalid {
  border-color: #f87171;
}
.footer-field textarea { resize: none; }

.f-error {
  color: #fca5a5;
  font-size: 0.75rem;
  font-weight: 600;
  margin-top: 0.3rem;
  min-height: 1rem;
}

.footer-submit-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.6rem;
  padding: 0.9rem 1.75rem;
  background: linear-gradient(135deg, var(--fa) 0%, #f5a800 100%);
  color: var(--fn-dark);
  border: none;
  border-radius: 0.875rem;
  font-size: 0.95rem;
  font-weight: 800;
  cursor: pointer;
  transition: all 0.25s ease;
  box-shadow: 0 4px 20px rgba(255,185,25,0.4);
  align-self: flex-start;
}
.footer-submit-btn:hover:not(:disabled) {
  transform: translateY(-2px);
  box-shadow: 0 8px 28px rgba(255,185,25,0.5);
}
.footer-submit-btn:disabled { opacity: 0.6; cursor: not-allowed; }
.btn-icon { flex-shrink: 0; }

.footer-success {
  display: flex;
  align-items: center;
  gap: 1rem;
  background: rgba(255,255,255,0.1);
  border: 1px solid rgba(255,255,255,0.2);
  border-radius: 1rem;
  padding: 1.25rem 1.5rem;
  color: var(--fw);
}
.footer-success.hidden { display: none; }
.fs-icon { font-size: 2rem; flex-shrink: 0; }
.footer-success strong { display: block; font-size: 1rem; margin-bottom: 0.2rem; }
.footer-success p { margin: 0; color: rgba(255,255,255,0.7); font-size: 0.88rem; }

/* ═══════════════════════════════════
   MAIN FOOTER
═══════════════════════════════════ */
.footer-main {
  background: var(--fn-dark);
  padding: 3.5rem 1.5rem 0;
  border-top: 1px solid rgba(255,255,255,0.06);
}

.footer-grid {
  display: grid;
  grid-template-columns: 2fr 1fr 1.5fr 1.5fr;
  gap: 3rem;
  padding-bottom: 3rem;
  border-bottom: 1px solid rgba(255,255,255,0.08);
}

/* Brand */
.footer-brand { }
.footer-logo { height: 80px; margin-bottom: 1rem; filter: brightness(1.1); }
.brand-tagline {
  color: rgba(255,255,255,0.55);
  font-size: 0.9rem;
  line-height: 1.65;
  margin-bottom: 1.5rem;
}
.footer-socials { display: flex; flex-wrap: wrap; gap: 0.6rem; }
.social-pill {
  display: inline-flex;
  align-items: center;
  gap: 0.45rem;
  padding: 0.45rem 0.9rem;
  border-radius: 999px;
  background: rgba(255,255,255,0.07);
  border: 1px solid rgba(255,255,255,0.12);
  color: rgba(255,255,255,0.8);
  font-size: 0.82rem;
  font-weight: 600;
  text-decoration: none;
  transition: all 0.2s;
}
.social-pill:hover {
  background: rgba(255,185,25,0.15);
  border-color: rgba(255,185,25,0.4);
  color: var(--fa);
}

/* Links columns */
.footer-links { }
.links-title {
  font-size: 0.78rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--fa);
  margin-bottom: 1.25rem;
}
.footer-links ul {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}
.footer-links ul li a,
.footer-links ul li .contact-meta {
  display: flex;
  align-items: flex-start;
  gap: 0.5rem;
  color: rgba(255,255,255,0.6);
  font-size: 0.9rem;
  text-decoration: none;
  transition: color 0.2s;
  line-height: 1.5;
}
.footer-links ul li a:hover { color: var(--fa); }
.footer-links ul li a svg,
.footer-links ul li .contact-meta svg { flex-shrink: 0; margin-top: 3px; opacity: 0.6; }

/* Schedule */
.schedule-list { gap: 1rem !important; }
.schedule-list li {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}
.sede-tag {
  display: inline-block;
  background: rgba(255,185,25,0.15);
  border: 1px solid rgba(255,185,25,0.3);
  color: var(--fa);
  padding: 0.15rem 0.6rem;
  border-radius: 999px;
  font-size: 0.7rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  width: fit-content;
  margin-bottom: 0.1rem;
}
.schedule-list li span:last-child {
  color: rgba(255,255,255,0.6);
  font-size: 0.88rem;
  line-height: 1.6;
}

/* Footer bottom */
.footer-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1.5rem 0;
  flex-wrap: wrap;
  gap: 1rem;
}
.footer-copy {
  color: rgba(255,255,255,0.35);
  font-size: 0.82rem;
  margin: 0;
}
.footer-wa-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.5rem 1.1rem;
  background: #25d366;
  color: var(--fw);
  border-radius: 999px;
  font-size: 0.82rem;
  font-weight: 700;
  text-decoration: none;
  transition: all 0.2s;
}
.footer-wa-btn:hover { background: #1da851; transform: translateY(-1px); }

/* ═══════════════════════════════════
   RESPONSIVE
═══════════════════════════════════ */
@media (max-width: 1024px) {
  .footer-grid { grid-template-columns: 1fr 1fr; gap: 2rem; }
}

@media (max-width: 768px) {
  .form-strip-inner { grid-template-columns: 1fr; gap: 2.5rem; }
  .footer-form-row { grid-template-columns: 1fr; }
  .footer-grid { grid-template-columns: 1fr; gap: 2rem; }
  .footer-bottom { flex-direction: column; text-align: center; }
  .footer-submit-btn { width: 100%; justify-content: center; }
}
</style>