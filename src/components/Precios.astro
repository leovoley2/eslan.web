---
import Icon from './Icon.astro';

const sesion = '30 min de físico, 1 h de técnica-táctica y 30 min de juego';

const planes = [
  {
    nombre: 'Básico',
    precio: 130,
    frecuencia: '1 vez por semana',
    features: ['4 clases al mes', 'Sesiones de 2 horas', sesion],
  },
  {
    nombre: 'Intermedio',
    precio: 170,
    frecuencia: '2 veces por semana',
    features: ['8 clases al mes', 'Sesiones de 2 horas', sesion],
  },
  {
    nombre: 'Avanzado',
    precio: 200,
    frecuencia: '3 veces por semana',
    features: ['12 clases al mes', 'Sesiones de 2 horas', sesion],
  },
  {
    nombre: 'Premium',
    precio: 250,
    frecuencia: '4 veces por semana',
    features: [sesion, 'Asesoramiento físico', 'Asesoramiento de fuerza', 'Videos de corrección de técnica'],
  },
];

const whatsappPlan = (nombre: string) =>
  `https://wa.me/51929418895?text=${encodeURIComponent(`Hola, me interesa el plan ${nombre}`)}`;
---

<section id="planes" class="section bg-sand-50">
  <div class="container-site">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div class="max-w-2xl">
        <p class="eyebrow">Planes</p>
        <h2 class="title-section">Elige cuántas veces quieres entrenar</h2>
        <p class="lead">Precios mensuales en soles. Sede Playa Agua Dulce, Chorrillos.</p>
      </div>
    </div>

    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {planes.map((plan) => (
        <article class="card flex flex-col p-6" data-animate>
          <h3 class="text-base font-bold">{plan.nombre}</h3>
          <p class="mt-1 text-sm text-ink-500">{plan.frecuencia}</p>

          <p class="mt-6 flex items-baseline gap-1">
            <span class="text-sm font-semibold text-ink-500">S/</span>
            <span class="font-display text-4xl font-extrabold tracking-tight text-ink-900">{plan.precio}</span>
            <span class="text-sm text-ink-400">/ mes</span>
          </p>

          <ul class="mt-6 flex-1 space-y-3 border-t border-ink-100 pt-6">
            {plan.features.map((feature) => (
              <li class="flex gap-2.5 text-sm leading-snug text-ink-600">
                <Icon name="check" class="mt-0.5 h-4 w-4 flex-none text-brand-600" />
                {feature}
              </li>
            ))}
          </ul>

          <a href={whatsappPlan(plan.nombre)} target="_blank" rel="noopener noreferrer" class="btn-secondary mt-8 w-full">
            Elegir {plan.nombre}
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
