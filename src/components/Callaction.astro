---
import Icon from './Icon.astro';

const reservasUrl = 'https://gesntion-de-academia.vercel.app';
---

<section class="bg-white pb-16 sm:pb-24">
  <div class="container-site">
    <div class="relative isolate overflow-hidden rounded-2xl bg-brand-800 px-6 py-14 sm:px-12 sm:py-16 lg:flex lg:items-center lg:justify-between lg:gap-12 lg:px-16">
      <img src="/atardecer.jpg" alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover opacity-20" loading="lazy" />

      <div class="max-w-xl">
        <p class="eyebrow-light">¿Listo para la arena?</p>
        <h2 class="mt-3 text-3xl font-extrabold leading-tight text-white sm:text-4xl">Empieza a entrenar esta semana</h2>
        <p class="mt-4 text-base leading-relaxed text-white/70">
          Crea tu cuenta, elige tu horario y asegura tu cupo en minutos. Te esperamos en la arena.
        </p>
        <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm text-white/80">
          <li class="flex items-center gap-2"><Icon name="check" class="h-4 w-4 text-accent-400" /> Coaches certificados FIVB</li>
          <li class="flex items-center gap-2"><Icon name="check" class="h-4 w-4 text-accent-400" /> Todos los niveles</li>
          <li class="flex items-center gap-2"><Icon name="check" class="h-4 w-4 text-accent-400" /> Reserva en línea</li>
        </ul>
      </div>

      <div class="mt-10 flex flex-col gap-3 sm:flex-row lg:mt-0 lg:flex-col">
        <a href={reservasUrl} target="_blank" rel="noopener noreferrer" class="btn-accent">
          Reservar mi clase <Icon name="arrow-right" class="h-4 w-4" />
        </a>
        <a href="#planes" class="btn-outline-light">Ver planes y precios</a>
      </div>
    </div>
  </div>
</section>
