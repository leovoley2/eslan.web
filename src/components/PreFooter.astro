---
import Icon from './Icon.astro';

// Para añadir una foto, agrega otro objeto a la lista (las rutas son de la carpeta `public`).
const images = [
  { src: '/voleo.jpg', alt: 'Jugadora realizando un voleo en la playa.' },
  { src: '/4.jpg', alt: 'Balón de vóley playa oficial de la FIVB en la arena al atardecer.' },
  { src: '/3.jpg', alt: 'Jugadora saltando para rematar el balón en un partido.' },
  { src: '/8.jpg', alt: 'Foto grupal del equipo femenino de Arena Voleibol Club.' },
  { src: '/antebrazo.jpg', alt: 'Jugadora recibiendo el balón con un antebrazo.' },
  { src: '/5.jpg', alt: 'Dos jugadoras bloqueando un remate en la red.' },
  { src: '/10.jpg', alt: 'Equipo completo de Arena Voleibol Club posando para una foto.' },
  { src: '/9.jpg', alt: 'Equipo juvenil de vóley playa.' },
  { src: '/6.jpg', alt: 'Dos jugadores compitiendo en la red durante un entrenamiento.' },
  { src: '/7.jpg', alt: 'Jugadores del club en un evento.' },
  { src: '/12.jpg', alt: 'Jugadora en el aire a punto de realizar un saque.' },
];
---

<section
  class="section bg-sand-50"
  x-data={`{
    open: false,
    index: 0,
    images: ${JSON.stringify(images)},
    show(i) { this.index = i; this.open = true; document.body.style.overflow = 'hidden'; },
    close() { this.open = false; document.body.style.overflow = ''; },
    next() { this.index = (this.index + 1) % this.images.length; },
    prev() { this.index = (this.index - 1 + this.images.length) % this.images.length; }
  }`}
  @keydown.escape.window="open && close()"
  @keydown.arrow-right.window="open && next()"
  @keydown.arrow-left.window="open && prev()"
>
  <div class="container-site">
    <div class="max-w-2xl">
      <p class="eyebrow">Galería</p>
      <h2 class="title-section">Momentos en la arena</h2>
      <p class="lead">Entrenamientos, partidos y la comunidad que hemos formado.</p>
    </div>

    <div class="mt-12 columns-2 gap-3 sm:gap-4 md:columns-3 lg:columns-4">
      {images.map((image, i) => (
        <button
          type="button"
          class="group mb-3 block w-full break-inside-avoid overflow-hidden rounded-lg bg-sand-100 sm:mb-4"
          @click={`show(${i})`}
          aria-label={`Ampliar foto: ${image.alt}`}
        >
          <img
            src={image.src}
            alt={image.alt}
            loading="lazy"
            class="h-auto w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
          />
        </button>
      ))}
    </div>
  </div>

  <!-- Visor de fotos -->
  <div
    x-show="open"
    x-transition.opacity
    class="fixed inset-0 z-[60] flex items-center justify-center bg-ink-900/95 p-4"
    role="dialog"
    aria-modal="true"
    aria-label="Visor de fotos"
    style="display: none;"
    @click.self="close()"
  >
    <button type="button" @click="close()" class="absolute right-4 top-4 flex h-11 w-11 items-center justify-center rounded-full text-white/80 hover:bg-white/10 hover:text-white" aria-label="Cerrar">
      <Icon name="close" class="h-6 w-6" />
    </button>
    <button type="button" @click="prev()" class="absolute left-2 top-1/2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full text-white/80 hover:bg-white/10 hover:text-white sm:left-4" aria-label="Foto anterior">
      <Icon name="chevron-left" class="h-6 w-6" />
    </button>
    <button type="button" @click="next()" class="absolute right-2 top-1/2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full text-white/80 hover:bg-white/10 hover:text-white sm:right-4" aria-label="Foto siguiente">
      <Icon name="chevron-right" class="h-6 w-6" />
    </button>

    <figure class="flex max-h-[88vh] max-w-5xl flex-col items-center">
      <img :src="images[index].src" :alt="images[index].alt" class="max-h-[80vh] w-auto rounded-lg object-contain" />
      <figcaption class="mt-3 text-center text-sm text-white/70" x-text="images[index].alt"></figcaption>
    </figure>
  </div>
</section>
