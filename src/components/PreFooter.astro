---
// 1. Define aquí todas tus imágenes.
// Para añadir una nueva, solo agrega otro objeto a la lista.
// Asegúrate de que las rutas (src) sean correctas dentro de tu carpeta `public`.
const images = [
  { src: "/voleo.jpg", alt: "Jugadora realizando un voleo en la playa." },
  { src: "/4.jpg", alt: "Balón de vóley playa oficial de la FIVB en la arena al atardecer." },
  { src: "/3.jpg", alt: "Jugadora saltando para rematar el balón en un partido." },
  { src: "/8.jpg", alt: "Foto grupal del equipo femenino de Arena Voleibol Club." },
  { src: "/antebrazo.jpg", alt: "Jugadora recibiendo el balón con un antebrazo perfecto." },
  { src: "/5.jpg", alt: "Dos jugadoras bloqueando un remate en la red." },
  { src: "/10.jpg", alt: "Equipo completo de Arena Voleibol Club posando para una foto." },
  { src: "/9.jpg", alt: "Foto del equipo juvenil de vóley playa." },
  { src: "/6.jpg", alt: "Dos jugadores compitiendo en la red durante un entrenamiento." },
  { src: "/7.jpg", alt: "Jugadores del club en un evento con ropa colorida." },
  { src: "/12.jpg", alt: "Jugadora en el aire a punto de realizar un saque potente." },
  // Agrega más imágenes aquí si lo deseas
];
---

<section 
  class="relative z-10 py-16 sm:py-24 overflow-hidden"
  style="background: linear-gradient(180deg, #0d4a6b 0%, #0a3d52 100%);"
  x-data="{ 
    open: false, 
    imageSrc: '',
    altText: '',
    currentIndex: 0,
    images: {images.map(img => ({ src: img.src, alt: img.alt }))}
  }"
  @keydown.escape.window="open = false"
  @keydown.arrow-right.window="currentIndex = (currentIndex + 1) % images.length; imageSrc = images[currentIndex].src"
  @keydown.arrow-left.window="currentIndex = (currentIndex - 1 + images.length) % images.length; imageSrc = images[currentIndex].src"
>
  <div class="container mx-auto px-6 lg:px-8">
    <div class="text-center">
      <div class="inline-flex items-center gap-2 bg-white/10 border border-white/20 rounded-full px-4 py-1.5 mb-4">
        <span class="text-white/80 text-xs font-semibold tracking-widest uppercase">Galería</span>
      </div>
      <h2 class="text-4xl font-extrabold tracking-tight text-white sm:text-5xl">
        Momentos en la Arena
      </h2>
      <p class="mt-4 text-lg leading-8 text-white/60 font-medium">
        Revive la energía de nuestros entrenamientos, partidos y la increíble comunidad que hemos formado.
      </p>
    </div>

    <div class="columns-2 md:columns-3 lg:columns-4 gap-4 mt-12">
      {images.map((image, index) => (
        <div 
          class="mb-4 break-inside-avoid cursor-pointer overflow-hidden rounded-2xl border border-white/10 p-1.5 hover:border-amber-400/60 hover:shadow-[0_8px_32px_0_rgba(255,185,25,0.2)] hover:-translate-y-1 transition-all duration-300 group"
          @click=`
            open = true; 
            imageSrc = '${image.src}'; 
            altText = '${image.alt}';
            currentIndex = ${index};
          `
        >
          <img
            src={image.src}
            alt={image.alt}
            class="h-auto w-full rounded-xl object-cover transition-transform duration-500 ease-in-out group-hover:scale-105"
            loading="lazy"
          />
        </div>
      ))}
    </div>
  </div>

  <div
    x-show="open"
    x-transition:enter="ease-out duration-300"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    x-transition:leave="ease-in duration-200"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    class="fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-80 backdrop-blur-sm p-4"
    style="display: none;"
  >
    <button @click="open = false" class="absolute top-4 right-4 text-white text-4xl z-50">&times;</button>
    
    <button 
      @click="currentIndex = (currentIndex - 1 + images.length) % images.length; imageSrc = images[currentIndex].src"
      class="absolute left-4 top-1/2 -translate-y-1/2 text-white text-4xl p-2 bg-black/30 rounded-full"
    >&#10094;</button>
    <button 
      @click="currentIndex = (currentIndex + 1) % images.length; imageSrc = images[currentIndex].src"
      class="absolute right-4 top-1/2 -translate-y-1/2 text-white text-4xl p-2 bg-black/30 rounded-full"
    >&#10095;</button>

    <div class="relative max-w-4xl max-h-[90vh] w-full h-full" @click.away="open = false">
      <img :src="imageSrc" :alt="altText" class="w-full h-full object-contain">
    </div>
  </div>
</section>