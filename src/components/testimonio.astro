---
const destacado = {
  nombre: 'Jesus Villafañe',
  rol: 'Jugador olímpico',
  foto: '/jesus.jpg',
  texto: 'El voleibol de playa es un deporte muy bonito que te da muchas oportunidades. Si quieres aprender un poco más, en Arena Voleibol Club puedes lograr ser un buen jugador, con un equipo de profesionales preparados para enseñarte.',
};

const otros = [
  {
    nombre: 'Lucelia Almeida',
    rol: 'Entrenadora · Chile',
    foto: '/lucelia.jpg',
    texto: 'Arena Voleibol Club es la escuela más indicada para aprender y perfeccionarse en el voleibol de playa en Perú: cuenta con grandes profesionales y mucha experiencia.',
  },
  {
    nombre: 'Mauro Hernandez',
    rol: 'Instructor FIVB · Venezuela',
    foto: '/mauro.jpg',
    texto: 'Es de gran importancia el desarrollo de academias donde se pueda practicar el voleibol de playa. Como entrenador e instructor me llena de alegría ver el trabajo de Arena Voleibol Club en Perú.',
  },
];
---

<section class="section bg-white">
  <div class="container-site">
    <div class="max-w-2xl">
      <p class="eyebrow">Testimonios</p>
      <h2 class="title-section">Lo que dicen de nosotros</h2>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-[1.25fr_1fr]">
      <figure class="card flex flex-col justify-between bg-brand-800 p-8 sm:p-10" data-animate>
        <blockquote class="font-display text-xl font-semibold leading-relaxed text-white sm:text-2xl">
          “{destacado.texto}”
        </blockquote>
        <figcaption class="mt-10 flex items-center gap-4">
          <img src={destacado.foto} alt="" loading="lazy" class="h-14 w-14 rounded-full object-cover" />
          <div>
            <p class="font-semibold text-white">{destacado.nombre}</p>
            <p class="text-sm text-accent-400">{destacado.rol}</p>
          </div>
        </figcaption>
      </figure>

      <div class="grid gap-6">
        {otros.map((t) => (
          <figure class="card flex flex-col justify-between p-6 sm:p-8" data-animate>
            <blockquote class="text-base leading-relaxed text-ink-700">“{t.texto}”</blockquote>
            <figcaption class="mt-6 flex items-center gap-3">
              <img src={t.foto} alt="" loading="lazy" class="h-11 w-11 rounded-full object-cover" />
              <div>
                <p class="text-sm font-semibold text-ink-900">{t.nombre}</p>
                <p class="text-sm text-ink-500">{t.rol}</p>
              </div>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </div>
</section>
