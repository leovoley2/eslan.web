---
const reservasUrl = 'https://gesntion-de-academia.vercel.app';

const pasos = [
  {
    numero: '01',
    icono: '📝',
    titulo: 'Regístrate',
    texto: 'Crea tu cuenta en nuestra plataforma con tus datos básicos. Solo te toma un par de minutos.',
  },
  {
    numero: '02',
    icono: '📅',
    titulo: 'Elige tu clase',
    texto: 'Revisa el calendario, los horarios disponibles y los cupos de cada entrenamiento.',
  },
  {
    numero: '03',
    icono: '🏐',
    titulo: 'Reserva y entrena',
    texto: 'Confirma tu lugar con un clic y llega a la arena. Tu cupo queda asegurado.',
  },
];

const beneficios = [
  'Reserva 24/7 desde tu celular',
  'Cupos garantizados en cada clase',
  'Consulta y gestiona tus reservas',
];
---

<!-- SECTION: Registro y reserva de clases en línea — cream palette -->
<section id="reservas" class="scroll-mt-14 sm:scroll-mt-16 lg:scroll-mt-20 relative z-10 overflow-hidden" style="background: linear-gradient(180deg, #fdf8e5 0%, #fff8e1 100%);">

  <!-- Amber glow orb -->
  <div class="absolute -top-24 -left-24 w-96 h-96 rounded-full pointer-events-none opacity-40"
    style="background: radial-gradient(circle, rgba(255,185,25,0.45) 0%, transparent 70%); filter: blur(60px);">
  </div>

  <div class="relative z-10 container mx-auto px-6 lg:px-8 py-20 sm:py-28">
    <!-- Section header -->
    <div class="text-center mb-14">
      <div class="inline-flex items-center gap-2 bg-[#0a3d52]/5 border border-[#0a3d52]/15 rounded-full px-4 py-1.5 mb-4">
        <span class="text-amber-500 text-xs">⚡</span>
        <span class="text-[#0a3d52]/80 text-xs font-semibold tracking-widest uppercase">Reservas en línea</span>
      </div>
      <h2 class="text-4xl sm:text-5xl font-black text-[#0a3d52] leading-tight">
        Regístrate y <span class="text-transparent bg-clip-text" style="background-image: linear-gradient(90deg, #FFB923, #0a5b8a);">reserva tus clases</span>
      </h2>
      <p class="mt-4 text-gray-600 max-w-2xl mx-auto text-lg">
        Ahora puedes asegurar tu lugar en la arena sin esperar respuesta por mensaje. Crea tu cuenta en nuestra plataforma y reserva tus entrenamientos cuando quieras.
      </p>
    </div>

    <!-- Steps -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
      {pasos.map(paso => (
        <article class="relative bg-white rounded-2xl p-6 border border-gray-100 shadow-[0_8px_30px_0_rgba(10,61,82,0.08)] hover:shadow-[0_12px_40px_0_rgba(255,185,25,0.25)] hover:-translate-y-1 transition-all duration-300">
          <span class="absolute top-4 right-5 text-4xl font-black text-[#0a3d52]/10">{paso.numero}</span>
          <div class="w-12 h-12 rounded-xl flex items-center justify-center mb-4" style="background: rgba(255,185,25,0.15);">
            <span class="text-2xl">{paso.icono}</span>
          </div>
          <h3 class="text-lg font-bold text-gray-900 mb-2">{paso.titulo}</h3>
          <p class="text-gray-600 text-sm leading-relaxed">{paso.texto}</p>
        </article>
      ))}
    </div>

    <!-- Benefits + CTA -->
    <div class="mt-12 flex flex-col items-center gap-8">
      <ul class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm text-gray-700">
        {beneficios.map(beneficio => (
          <li class="flex items-center gap-2"><span class="text-amber-500 font-bold">✓</span> {beneficio}</li>
        ))}
      </ul>

      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <a href={reservasUrl} target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-3 font-black py-4 px-10 text-lg rounded-full text-white shadow-[0_8px_30px_0_rgba(10,91,138,0.35)] hover:shadow-[0_12px_40px_0_rgba(10,91,138,0.5)] hover:scale-105 transform transition-all duration-300 active:scale-95"
          style="background: linear-gradient(135deg, #0a5b8a, #0a3d52);">
          <span>REGISTRARME Y RESERVAR</span>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
        </a>
        <a href={reservasUrl} target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 border-2 border-[#0a3d52]/30 text-[#0a3d52] font-bold py-4 px-8 rounded-full hover:border-[#0a3d52] hover:bg-[#0a3d52]/5 transition-all duration-300">
          Ya tengo cuenta
        </a>
      </div>
    </div>
  </div>
</section>
