---
import Icon from './Icon.astro';

const reservasUrl = 'https://gesntion-de-academia.vercel.app';

const pasos = [
  {
    icono: 'pencil',
    titulo: 'Regístrate',
    texto: 'Crea tu cuenta en nuestra plataforma con tus datos básicos. Solo toma un par de minutos.',
  },
  {
    icono: 'calendar',
    titulo: 'Elige tu clase',
    texto: 'Revisa el calendario, los horarios disponibles y los cupos de cada entrenamiento.',
  },
  {
    icono: 'check',
    titulo: 'Reserva y entrena',
    texto: 'Confirma tu lugar con un clic y llega a la arena. Tu cupo queda asegurado.',
  },
] as const;

const beneficios = [
  'Reserva 24/7 desde tu celular',
  'Cupos garantizados en cada clase',
  'Consulta y gestiona tus reservas',
];
---

<!-- Registro y reserva de clases en línea -->
<section id="reservas" class="section bg-sand-100">
  <div class="container-site">
    <div class="grid gap-12 lg:grid-cols-[1fr_1.4fr] lg:items-center lg:gap-16">

      <div>
        <p class="eyebrow">Reservas en línea</p>
        <h2 class="title-section">Regístrate y reserva tus clases</h2>
        <p class="lead">
          Asegura tu lugar en la arena sin esperar respuesta por mensaje. Crea tu cuenta en nuestra plataforma y reserva tus entrenamientos cuando quieras.
        </p>

        <ul class="mt-6 space-y-2.5">
          {beneficios.map((beneficio) => (
            <li class="flex items-center gap-2.5 text-sm text-ink-700">
              <Icon name="check" class="h-4 w-4 flex-none text-brand-600" />
              {beneficio}
            </li>
          ))}
        </ul>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href={reservasUrl} target="_blank" rel="noopener noreferrer" class="btn-primary">
            Registrarme y reservar <Icon name="arrow-up-right" class="h-4 w-4" />
          </a>
          <a href={reservasUrl} target="_blank" rel="noopener noreferrer" class="btn-secondary">
            Ya tengo cuenta
          </a>
        </div>
      </div>

      <ol class="grid gap-4 sm:grid-cols-3 lg:grid-cols-1" data-animate>
        {pasos.map((paso, i) => (
          <li class="card flex gap-5 p-6">
            <span class="icon-tile"><Icon name={paso.icono} /></span>
            <div>
              <p class="text-xs font-semibold uppercase tracking-eyebrow text-ink-400">Paso {i + 1}</p>
              <h3 class="mt-1 text-base font-bold">{paso.titulo}</h3>
              <p class="mt-1.5 text-sm leading-relaxed text-ink-500">{paso.texto}</p>
            </div>
          </li>
        ))}
      </ol>

    </div>
  </div>
</section>
