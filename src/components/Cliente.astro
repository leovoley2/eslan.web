---
import Icon from './Icon.astro';

const sponsorUrl = 'https://wa.me/51929418895?text=Hola,%20estoy%20interesado%20en%20ser%20sponsor%20de%20Arena%20Voleibol%20Club.';

const stats = [
  { value: '500+', label: 'Atletas activos' },
  { value: '5+', label: 'Años de experiencia' },
  { value: '2', label: 'Sedes en Lima' },
  { value: '12K+', label: 'Seguidores en redes' },
];

const benefits = [
  { icon: 'eye', title: 'Visibilidad', desc: 'Tu marca frente a cientos de atletas, familias y aficionados cada semana.' },
  { icon: 'photo', title: 'Presencia digital', desc: 'Logo en nuestro sitio web, redes sociales y material de torneos.' },
  { icon: 'heart', title: 'Asociación de marca', desc: 'Vincúlate con los valores del deporte: esfuerzo, salud y comunidad.' },
  { icon: 'users', title: 'Público segmentado', desc: 'Llega directo a jóvenes activos y familias.' },
] as const;
---

<section id="sponsors" class="section border-t border-ink-100 bg-white">
  <div class="container-site">
    <div class="grid gap-12 lg:grid-cols-[1fr_1.3fr] lg:gap-16">
      <div>
        <p class="eyebrow">Patrocinios</p>
        <h2 class="title-section">Haz que tu marca brille en la arena</h2>
        <p class="lead">
          Asocia tu marca con la comunidad más apasionada del vóley playa en Lima.
        </p>

        <dl class="mt-8 grid grid-cols-2 gap-x-6 gap-y-5 border-t border-ink-100 pt-6">
          {stats.map((stat) => (
            <div>
              <dt class="text-sm text-ink-500">{stat.label}</dt>
              <dd class="mt-0.5 font-display text-2xl font-extrabold text-ink-900">{stat.value}</dd>
            </div>
          ))}
        </dl>

        <a href={sponsorUrl} target="_blank" rel="noopener noreferrer" class="btn-primary mt-8">
          Quiero ser sponsor <Icon name="arrow-right" class="h-4 w-4" />
        </a>
      </div>

      <ul class="grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:pt-10">
        {benefits.map((b) => (
          <li>
            <span class="icon-tile"><Icon name={b.icon} /></span>
            <h3 class="mt-4 text-base font-bold">{b.title}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-ink-500">{b.desc}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
