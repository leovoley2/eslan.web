---
import Icon from './Icon.astro';

const programas = [
  {
    titulo: 'Aprende jugando',
    texto: 'Aprende este deporte, ejercítate, haz nuevos amigos y vive la energía de la playa.',
    imagen: '/ataque.jpg',
    href: '/aprendo',
    cta: 'Ver beneficios',
  },
  {
    titulo: '¿Qué nivel tienes?',
    texto: 'Autoevalúate en 5 preguntas y descubre qué entrenamiento te ayuda a subir de nivel.',
    imagen: '/mascuino.jpg',
    href: '/niveles',
    cta: 'Evaluar mi nivel',
  },
  {
    titulo: 'Clínicas por fundamento',
    texto: 'Sesiones enfocadas en saque, recepción, ataque, bloqueo y defensa, de iniciación a alto rendimiento.',
    imagen: '/grupal.jpg',
    href: '/clinicas',
    cta: 'Ver clínicas',
  },
  {
    titulo: 'Torneos',
    texto: 'Competencias durante todo el año para medir tu progreso y vivir la emoción del juego.',
    imagen: '/tomando.jpg',
    href: '/contacto',
    cta: 'Consultar fechas',
  },
];
---

<section class="section bg-white">
  <div class="container-site">
    <div class="max-w-2xl">
      <p class="eyebrow">Programas</p>
      <h2 class="title-section">Todo lo que puedes vivir en la arena</h2>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {programas.map((programa) => (
        <a href={programa.href} class="group flex flex-col" data-animate>
          <div class="aspect-[4/5] overflow-hidden rounded-xl bg-sand-100">
            <img
              src={programa.imagen}
              alt=""
              loading="lazy"
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
            />
          </div>
          <h3 class="mt-5 text-lg font-bold">{programa.titulo}</h3>
          <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-500">{programa.texto}</p>
          <span class="link-arrow mt-4">
            {programa.cta} <Icon name="arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" />
          </span>
        </a>
      ))}
    </div>
  </div>
</section>
