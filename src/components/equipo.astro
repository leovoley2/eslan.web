---
const coaches = [
  {
    nombre: 'Leobardo Sanabria',
    rol: 'Entrenador jefe',
    credencial: 'Entrenador FIVB internacional nivel 2',
    foto: '/leo.JPG',
    instagram: 'https://www.instagram.com/leobardo2/',
    facebook: 'https://www.facebook.com/Leovoley2/',
  },
  {
    nombre: 'Maryuris Cabeza',
    rol: 'Entrenadora Arena Kids',
    credencial: 'Formación infantil y juvenil',
    foto: '/maryu.jpg',
    instagram: 'https://www.instagram.com/maryuris1/',
    facebook: 'https://www.facebook.com/ruiz.ruiz.737',
  },
  {
    nombre: 'Adrian Azocar',
    rol: 'Entrenador',
    credencial: 'Entrenador FIVB internacional nivel 1',
    foto: '/2.jpg',
    instagram: 'https://www.instagram.com/adrianazocar94/',
    facebook: 'https://www.facebook.com/adrianjose.azocarblanco',
  },
];
---

<section class="section bg-white">
  <div class="container-site">
    <div class="max-w-2xl">
      <p class="eyebrow">Equipo</p>
      <h2 class="title-section">Entrenadores certificados FIVB</h2>
      <p class="lead">Coaches con formación internacional que te acompañan desde tu primer toque hasta la competencia.</p>
    </div>

    <ul class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {coaches.map((coach) => (
        <li data-animate>
          <div class="aspect-[4/5] overflow-hidden rounded-xl bg-sand-100">
            <img src={coach.foto} alt={coach.nombre} loading="lazy" class="h-full w-full object-cover object-top" />
          </div>
          <div class="mt-5 flex items-start justify-between gap-4">
            <div>
              <h3 class="text-lg font-bold">{coach.nombre}</h3>
              <p class="mt-0.5 text-sm font-medium text-brand-600">{coach.rol}</p>
              <p class="mt-1 text-sm text-ink-500">{coach.credencial}</p>
            </div>
            <div class="flex flex-none gap-1">
              <a href={coach.instagram} target="_blank" rel="noopener noreferrer" aria-label={`Instagram de ${coach.nombre}`} class="flex h-9 w-9 items-center justify-center rounded-full text-ink-400 transition-colors hover:bg-ink-50 hover:text-ink-800">
                <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
              </a>
              <a href={coach.facebook} target="_blank" rel="noopener noreferrer" aria-label={`Facebook de ${coach.nombre}`} class="flex h-9 w-9 items-center justify-center rounded-full text-ink-400 transition-colors hover:bg-ink-50 hover:text-ink-800">
                <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              </a>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
