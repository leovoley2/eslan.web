	/* Scroll Animation Styles */
	[data-animate] {
		opacity: 0;
		transition: all 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94);
	}

	/* Fade animations */
	[data-animate="fade"] {
		opacity: 0;
	}

	[data-animate="fade"].animate-in,
	.fade-in {
		opacity: 1;
	}

	/* Fade up animation */
	[data-animate="fade-up"] {
		opacity: 0;
		transform: translateY(50px);
	}

	[data-animate="fade-up"].animate-in,
	.fade-up-in {
		opacity: 1;
		transform: translateY(0);
	}

	/* Fade left animation */
	[data-animate="fade-left"] {
		opacity: 0;
		transform: translateX(-50px);
	}

	[data-animate="fade-left"].animate-in,
	.fade-left-in {
		opacity: 1;
		transform: translateX(0);
	}

	/* Fade right animation */
	[data-animate="fade-right"] {
		opacity: 0;
		transform: translateX(50px);
	}

	[data-animate="fade-right"].animate-in,
	.fade-right-in {
		opacity: 1;
		transform: translateX(0);
	}

	/* Scale animation */
	[data-animate="scale"] {
		opacity: 0;
		transform: scale(0.8);
	}

	[data-animate="scale"].animate-in,
	.scale-in {
		opacity: 1;
		transform: scale(1);
	}

	/* Slide up animation */
	[data-animate="slide-up"] {
		opacity: 0;
		transform: translateY(100px);
	}

	[data-animate="slide-up"].animate-in,
	.slide-up-in {
		opacity: 1;
		transform: translateY(0);
	}

	/* Enhanced animations with spring effect */
	.animate-in {
		animation-fill-mode: both;
	}

	/* Stagger delay utilities */
	[data-stagger] > * {
		transition-delay: 0.1s;
	}

	/* Parallax elements */
	[data-parallax] {
		will-change: transform;
	}

	/* Counter animation */
	[data-counter] {
		font-variant-numeric: tabular-nums;
	}

	/* Smooth scroll behavior */
	html {
		scroll-behavior: smooth;
	}

	/* Performance optimizations */
	[data-animate] {
		will-change: opacity, transform;
		backface-visibility: hidden;
		-webkit-backface-visibility: hidden;
	}

	/* Animation entrance variants */
	@keyframes bounceIn {
		0% {
			opacity: 0;
			transform: scale(0.3);
		}
		50% {
			opacity: 1;
			transform: scale(1.05);
		}
		70% {
			transform: scale(0.9);
		}
		100% {
			opacity: 1;
			transform: scale(1);
		}
	}

	@keyframes slideInUp {
		0% {
			opacity: 0;
			transform: translateY(100px);
		}
		100% {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes fadeInLeft {
		0% {
			opacity: 0;
			transform: translateX(-100px);
		}
		100% {
			opacity: 1;
			transform: translateX(0);
		}
	}

	@keyframes fadeInRight {
		0% {
			opacity: 0;
			transform: translateX(100px);
		}
		100% {
			opacity: 1;
			transform: translateX(0);
		}
	}

	/* Special animation classes */
	.bounce-in {
		animation: bounceIn 0.8s ease-out;
	}

	.slide-in-up {
		animation: slideInUp 0.8s ease-out;
	}

	.fade-in-left {
		animation: fadeInLeft 0.8s ease-out;
	}

	.fade-in-right {
		animation: fadeInRight 0.8s ease-out;
	}

	/* Hover enhance animations */
	[data-animate]:hover {
		transform: translateY(-2px);
		transition: transform 0.3s ease;
	}

	/* Reduce motion for accessibility */
	@media (prefers-reduced-motion: reduce) {
		[data-animate] {
			transition: none !important;
			animation: none !important;
		}
		
		html {
			scroll-behavior: auto;
		}
	}

	
</style>
