---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import Equipo from '../components/equipo.astro';

const pilares = [
  {
    nombre: 'Desarrollo deportivo',
    descripcion: 'Entrenamiento de excelencia para jugadores de todos los niveles, enfocado en mejorar la técnica y la destreza en la cancha.',
    icono: 'trophy',
  },
  {
    nombre: 'Promoción del deporte',
    descripcion: 'Fomentamos la participación y el entusiasmo por el vóley playa en la comunidad, con torneos y eventos para todas las edades.',
    icono: 'megaphone',
  },
  {
    nombre: 'Detección de talentos',
    descripcion: 'Identificamos y apoyamos a jóvenes con potencial para que representen a Perú en competencias nacionales e internacionales.',
    icono: 'star',
  },
  {
    nombre: 'Vida saludable',
    descripcion: 'Promovemos hábitos saludables y la actividad física regular como parte del bienestar integral de nuestros miembros.',
    icono: 'heart',
  },
] as const;
---

<Layout title="Nosotros · Arena Voleibol Club" description="Conoce la filosofía, los pilares y el equipo de Arena Voleibol Club, escuela de vóley playa en Lima.">
  <PageHeader
    eyebrow="Nosotros"
    title="Ponte en forma, diviértete y haz amigos"
    description="Esa es nuestra filosofía. En Arena Voleibol Club creemos que el deporte transforma vidas: un espacio donde la competencia sana, la vida saludable y la amistad se encuentran en cada entrenamiento."
    image="/10.jpg"
  />

  <main>
    <section class="section bg-white">
      <div class="container-site">
        <div class="max-w-2xl">
          <p class="eyebrow">Nuestros pilares</p>
          <h2 class="title-section">Lo que guía cada entrenamiento</h2>
        </div>

        <dl class="mt-12 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
          {pilares.map((pilar) => (
            <div data-animate>
              <dt>
                <span class="icon-tile"><Icon name={pilar.icono} /></span>
                <span class="mt-5 block font-display text-lg font-bold text-ink-900">{pilar.nombre}</span>
              </dt>
              <dd class="mt-2 text-sm leading-relaxed text-ink-500">{pilar.descripcion}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section class="bg-white pb-16 sm:pb-24">
      <div class="container-site grid gap-10 lg:grid-cols-2 lg:items-center lg:gap-16">
        <div class="aspect-[4/3] overflow-hidden rounded-xl bg-sand-100">
          <img src="/8.jpg" alt="Equipo femenino de Arena Voleibol Club" loading="lazy" class="h-full w-full object-cover" />
        </div>
        <div>
          <p class="eyebrow">Comunidad</p>
          <h2 class="title-section">Más que un club, una comunidad</h2>
          <p class="lead">
            Entrenamos en Chorrillos y Surco con grupos de todos los niveles. Aquí encontrarás coaches que te corrigen con detalle, compañeros que te empujan a mejorar y torneos para medir tu progreso.
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href="/#reservas" class="btn-primary">Reservar clase</a>
            <a href="/servicios" class="btn-secondary">Ver servicios</a>
          </div>
        </div>
      </div>
    </section>

    <div class="border-t border-ink-100">
      <Equipo />
    </div>
  </main>
</Layout>
