---
import Layout from '../layouts/Layout.astro';
// 1. Define aquí los pilares de tu club (basado en tus "Metas").
// Encuentra más íconos en https://heroicons.com/
const pilares = [
  {
    nombre: 'Desarrollo Deportivo',
    descripcion: 'Brindamos entrenamiento de excelencia para jugadores de todos los niveles, enfocados en mejorar la técnica y destreza en la cancha.',
    // Icono: Trofeo
    icono: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 18.75h-9a9 9 0 119 0zM16.5 18.75a9 9 0 10-9 0h9zM12.75 12.75h-1.5V9h1.5v3.75z" /><path stroke-linecap="round" stroke-linejoin="round" d="M12 15.75h.008v.008H12v-.008z" /><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75a7.5 7.5 0 0115 0v2.25a2.25 2.25 0 01-2.25 2.25h-10.5A2.25 2.25 0 014.5 15v-2.25z" /></svg>`
  },
  {
    nombre: 'Promoción del Deporte',
    descripcion: 'Fomentamos la participación y el entusiasmo por el vóley playa en la comunidad, organizando torneos y eventos para todas las edades.',
    // Icono: Megáfono
    icono: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 11-3 0m3 0a1.5 1.5 0 10-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-9.75 0h9.75" /></svg>`
  },
  {
    nombre: 'Detección de Talentos',
    descripcion: 'Identificamos y apoyamos a jóvenes con potencial para que representen a Perú en competencias nacionales e internacionales.',
    // Icono: Estrella
    icono: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8"><path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" /></svg>`
  },
  {
    nombre: 'Vida Saludable',
    descripcion: 'Promovemos hábitos saludables y la actividad física regular como parte fundamental del bienestar integral de nuestros miembros.',
    // Icono: Hoja
    icono: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8"><path stroke-linecap="round" stroke-linejoin="round" d="M15.182 8.418a3.375 3.375 0 00-4.773 0l-4.5 4.5a3.375 3.375 0 004.773 4.774l.73-1.46a.375.375 0 01.529-.158l.128.054a.375.375 0 01.158.53l-1.46.73a4.875 4.875 0 01-6.895-6.895l4.5-4.5a4.875 4.875 0 016.895 0l.73 1.46a.375.375 0 01-.158.529l-.054.128a.375.375 0 01-.53.158l-1.46-.73z" /></svg>`
  }
];
---

<Layout title="Arena - Nosotros" description="Descubre más información sobre nosotros">

<section class="bg-white py-24 sm:py-32">
  <div class="container mx-auto px-6 lg:px-8">
    
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-4xl font-bold tracking-tight text-[#01577a] sm:text-5xl leading-tight">
        Ponte en Forma, Diviértete y Haz Amigos.
      </h2>
      <p class="mt-6 text-lg leading-8 text-gray-700">
        Esa es nuestra filosofía. En Arena Voleibol Club, creemos que el deporte es una herramienta para transformar vidas. Ofrecemos un espacio donde la competencia sana, la vida saludable y la amistad se encuentran en cada entrenamiento.
      </p>
    </div>

    <div class="mt-20">
      <dl class="grid grid-cols-1 gap-12 sm:grid-cols-2 lg:grid-cols-4">
        {pilares.map((pilar) => (
          <div class="flex flex-col items-center text-center p-4">
            <div class="flex h-14 w-14 items-center justify-center rounded-full bg-cyan-100 text-[#01577a]" set:html={pilar.icono} />
            <dt class="mt-4 font-semibold text-xl text-gray-900">{pilar.nombre}</dt>
            <dd class="mt-2 text-base leading-7 text-gray-600">{pilar.descripcion}</dd>
          </div>
        ))}
      </dl>
    </div>
    
  </div>
</section>
</Layout>
