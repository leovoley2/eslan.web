];
     
---


<Layout title="Arena Voleibol club - contacto" description="Contactanos y comienza la diversión con el voleibol de playa">
   <!-- component -->
   <script>
    document.addEventListener('DOMContentLoaded', () => {
      const locationSelect = document.getElementById('locationSelect');
      const locationContainers = document.querySelectorAll('[id^="location-"]');
      const modal = document.getElementById('imageModal');
      const modalImage = document.getElementById('modalImage');
      const modalTitle = document.getElementById('modalTitle');
      const modalDescription = document.getElementById('modalDescription');
      const closeModal = document.getElementById('closeModal');
  
      locationSelect?.addEventListener('change', (e) => {
        const target = e.target as HTMLSelectElement;
        const selectedLocation = target.value;
        
        locationContainers.forEach(container => {
          container.classList.add('hidden');
        });
        
        document.getElementById(`location-${selectedLocation}`)?.classList.remove('hidden');
      });
  
      document.querySelectorAll('.gallery-image').forEach(image => {
        image.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLElement;
          if (modal && modalImage && modalTitle && modalDescription) {
            modalImage.setAttribute('src', target.dataset.image || '');
            modalTitle.textContent = target.dataset.title || '';
            modalDescription.textContent = target.dataset.description || '';
            modal.classList.remove('hidden');
          }
        });
      });
  
      closeModal?.addEventListener('click', () => {
        modal?.classList.add('hidden');
      });
    });
  </script>
  
  <div class="max-w-6xl mx-auto p-4">
    <h2 class="text-3xl font-bold text-center text-[#01577a] mb-8">Nuestras Sedes</h2>
    
    <div class="mb-8">
      <label for="locationSelect" class="block text-sm font-medium text-[#01577a] mb-2">
        Selecciona una sede
      </label>
      <select
        id="locationSelect"
        class="block w-full max-w-xs rounded-lg border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500"
      >
        {locations.map(location => (
          <option value={location.id}>{location.name}</option>
        ))}
      </select>
    </div>
  
    {locations.map((location, index) => (
      <div id={`location-${location.id}`} class={index === 0 ? '' : 'hidden'}>
        <div class="grid md:grid-cols-2 gap-8 mb-12">
          <!-- Información y mapa -->
          <div class="bg-[#01577a] rounded-xl shadow-lg overflow-hidden">
            <div class="aspect-video w-full">
              <iframe
                src={location.mapUrl}
                class="w-full h-full border-0"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
              ></iframe>
            </div>
            
            <div class="p-6">
              <h3 class="text-2xl font-bold mb-4">{location.name}</h3>
              
              <div class="space-y-3">
                <div class="flex items-start gap-3">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-[#f8ecbc] mt-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  <p>{location.address}</p>
                </div>
                
                <div class="flex items-center gap-3">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-[#f8ecbc]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                  <p>{location.phone}</p>
                </div>
                
                <div class="flex items-center gap-3">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-[#f8ecbc]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <p>{location.schedule}</p>
                </div>
                
                <div class="flex items-center gap-3">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-[#f8ecbc]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                  <p>{location.email}</p>
                </div>
              </div>
              
              <a 
                href={`https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(location.address)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-6 w-full inline-block text-center bg-[#f8ecbc] text-[#01577a] py-2 px-4 rounded-lg hover:bg-[#ffb919] ease-in-out duration-700"
              >
                Cómo llegar
              </a>
            </div>
          </div>
  
          <!-- Galería de imágenes -->
          <div class="grid grid-cols-1 gap-4">
            {location.images.map(image => (
              <div
                class="gallery-image cursor-pointer overflow-hidden rounded-lg shadow-lg transition-transform hover:scale-[1.02]"
                data-image={image.url}
                data-title={image.title}
                data-description={image.description}
              >
                <img
                  src={image.url}
                  alt={image.title}
                  class="w-full h-48 object-cover"
                />
                <div class="p-4 bg-[#01577a] text-white">
                  <h3 class="font-bold text-lg mb-1">{image.title}</h3>
                  <p class="text-[#f8ecbc]">{image.description}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    ))}
  
    <!-- Modal -->
    <div id="imageModal" class="hiden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4">
      <div class="bg-white rounded-lg max-w-3xl w-full">
        <div class="p-4 border-b flex justify-between items-center">
          <h3 id="modalTitle" class="text-xl font-bold"></h3>
          <button id="closeModal" class="text-gray-500 hover:text-gray-700">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>
        <div class="p-4">
          <img id="modalImage" class="w-full rounded-lg" src="" alt="" />
          <p id="modalDescription" class="mt-4 text-gray-600"></p>
        </div>
      </div>
    </div>
  </div>
   
</Layout>
<!-- component -->
