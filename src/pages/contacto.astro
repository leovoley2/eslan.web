    schedule: 'Lun - Mie - Vie: 7:00 - 9:00 AM',
    email: 'arenavoleibolclub@gmail.com',
    mapUrl: 'https://maps.app.goo.gl/sHBHCijPnvBbEjnp6',
    images: [
      {
        url: '/public/IMG_2641.PNG',
        title: 'Recepción',
        description: 'Área de recepción moderna y acogedora'
      },
      {
        url: '/public/IMG_2639.PNG',
        title: 'Oficinas',
        description: 'Espacios de trabajo colaborativo'
      },
      {
        url: '/public/IMG_20240214_091235_Original.JPG',
        title: 'Sala de Reuniones',
        description: 'Sala equipada para conferencias'
      },
      {
        url: '/public/IMG_2641.PNG',
        title: 'Cafetería',
        description: 'Zona de descanso y refrigerio'
      }
    ]
  },
  {
    id: 'sede2',
    name: 'Sede Surco',
    address: 'Jr. Progreso 576',
    phone: '929418895',
    schedule: 'Mar - Juv: 5:00 - 9:00 PM',
    email: 'arenavoleibolclub@gmail.com',
    mapUrl: 'https://maps.app.goo.gl/sHBHCijPnvBbEjnp6',
    images: [
      {
        url: '/public/IMG_2640.PNG',
        title: 'Fachada',
        description: 'Entrada principal del edificio'
      },
      {
        url: '/public/IMG_2640.PNG',
        title: 'Área de Trabajo',
        description: 'Espacio de trabajo moderno'
      },
      {
        url: '/public/IMG_2640.PNG',
        title: 'Sala de Juntas',
        description: 'Espacio para reuniones ejecutivas'
      },
      {
        url: '/public/IMG_2640.PNG',
        title: 'Terraza',
        description: 'Área de descanso al aire libre'
      }
