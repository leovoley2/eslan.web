---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';

const locations = [
  {
    id: 'sede1',
    name: 'Sede Chorrillos',
    subtitle: 'Playa Agua Dulce',
    address: 'Playa Agua Dulce, Chorrillos',
    phone: '929 418 895',
    schedule: 'Lun · Mié · Vie · Sáb, 6:30 – 8:30 a. m.',
    email: 'arenavoleibolclub@gmail.com',
    mapEmbed: 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3901.7!2d-77.0227!3d-12.1764!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x9105b7e14f5e8a4d%3A0x0!2sPlaya+Agua+Dulce!5e0!3m2!1ses!2spe!4v1700000000000',
    mapDir: 'https://www.google.com/maps/dir/?api=1&destination=Playa+Agua+dulce+Chorrillos',
    whatsapp: 'https://wa.me/51929418895?text=Hola!%20Estoy%20interesado%20en%20la%20Sede%20Chorrillos',
    images: [
      { url: '/IMG_2639.jpg', label: 'Cancha principal' },
      { url: '/IMG_2640.jpg', label: 'Área de entrenamiento' },
      { url: '/IMG_20240214_091235_Original.JPG', label: 'Amanecer en la playa' },
    ]
  },
  {
    id: 'sede2',
    name: 'Sede Surco',
    subtitle: 'Jr. Progreso 576',
    address: 'Jr. Progreso 576, Surco',
    phone: '929 418 895',
    schedule: 'Mar · Jue, 6:00 – 8:00 p. m.',
    email: 'arenavoleibolclub@gmail.com',
    mapEmbed: 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3901.2!2d-76.9913!3d-12.1495!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x9105c77e0bea2a43%3A0x3fc94a78b6f0756b!2sJr.+Progreso+576+Surco!5e0!3m2!1ses!2spe!4v1700000000001',
    mapDir: 'https://www.google.com/maps/dir/?api=1&destination=Jr.+Progreso+576+Surco',
    whatsapp: 'https://wa.me/51929418895?text=Hola!%20Estoy%20interesado%20en%20la%20Sede%20Surco',
    images: [
      { url: '/arenanocturno.png', label: 'Cancha nocturna' },
      { url: '/IMG_2640.jpg', label: 'Entrenamiento' },
      { url: '/IMG_2639.jpg', label: 'Instalaciones' },
    ]
  }
];
---

<Layout title="Contacto · Arena Voleibol Club" description="Contáctanos y comienza a jugar voleibol de playa. Sedes en Chorrillos y Surco, Lima." hideFooterForm={true}>
  <PageHeader
    eyebrow="Contacto"
    title="Hablemos de voleibol"
    description="Dos sedes listas para recibirte. Elige la más cercana y únete a la comunidad Arena."
  />

  <main>
    <!-- Sedes -->
    <section class="section bg-white">
      <div class="container-site">
        <div class="inline-flex rounded-full border border-ink-200 bg-sand-50 p-1" role="tablist" aria-label="Sedes">
          {locations.map((loc, i) => (
            <button
              type="button"
              class={`sede-tab ${i === 0 ? 'active' : ''}`}
              data-tab={loc.id}
              id={`tab-${loc.id}`}
              role="tab"
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-controls={`panel-${loc.id}`}
              tabindex={i === 0 ? 0 : -1}
            >
              {loc.name}
            </button>
          ))}
        </div>

        {locations.map((loc, i) => (
          <div id={`panel-${loc.id}`} class={`sede-panel mt-8 ${i !== 0 ? 'hidden' : ''}`} role="tabpanel" aria-labelledby={`tab-${loc.id}`}>
            <div class="grid gap-6 lg:grid-cols-[1fr_1.2fr]">

              <div class="card flex flex-col p-6 sm:p-8">
                <h2 class="text-2xl font-extrabold">{loc.name}</h2>
                <p class="mt-1 text-sm text-ink-500">{loc.subtitle}</p>

                <dl class="mt-6 flex-1 space-y-5">
                  <div class="flex gap-4">
                    <span class="icon-tile"><Icon name="map-pin" /></span>
                    <div>
                      <dt class="text-sm text-ink-500">Dirección</dt>
                      <dd class="font-medium text-ink-900">{loc.address}</dd>
                    </div>
                  </div>
                  <div class="flex gap-4">
                    <span class="icon-tile"><Icon name="clock" /></span>
                    <div>
                      <dt class="text-sm text-ink-500">Horario</dt>
                      <dd class="font-medium text-ink-900">{loc.schedule}</dd>
                    </div>
                  </div>
                  <div class="flex gap-4">
                    <span class="icon-tile"><Icon name="phone" /></span>
                    <div>
                      <dt class="text-sm text-ink-500">Teléfono</dt>
                      <dd><a href={`tel:+51${loc.phone.replace(/\s/g,'')}`} class="font-medium text-ink-900 hover:text-brand-600">{loc.phone}</a></dd>
                    </div>
                  </div>
                  <div class="flex gap-4">
                    <span class="icon-tile"><Icon name="mail" /></span>
                    <div class="min-w-0">
                      <dt class="text-sm text-ink-500">Correo</dt>
                      <dd><a href={`mailto:${loc.email}`} class="break-all font-medium text-ink-900 hover:text-brand-600">{loc.email}</a></dd>
                    </div>
                  </div>
                </dl>

                <div class="mt-8 flex flex-col gap-3 sm:flex-row">
                  <a href={loc.mapDir} target="_blank" rel="noopener noreferrer" class="btn-primary">
                    <Icon name="map-pin" class="h-4 w-4" /> Cómo llegar
                  </a>
                  <a href={loc.whatsapp} target="_blank" rel="noopener noreferrer" class="btn-secondary">
                    Escribir por WhatsApp
                  </a>
                </div>
              </div>

              <div class="grid gap-4">
                <div class="overflow-hidden rounded-xl border border-ink-100 bg-sand-100">
                  <iframe
                    src={loc.mapEmbed}
                    class="block h-64 w-full sm:h-72"
                    allowfullscreen=""
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    title={`Mapa de ${loc.name}`}
                  ></iframe>
                </div>
                <div class="grid grid-cols-3 gap-4">
                  {loc.images.map((img) => (
                    <figure class="aspect-[4/3] overflow-hidden rounded-lg bg-sand-100">
                      <img src={img.url} alt={img.label} loading="lazy" class="h-full w-full object-cover" />
                    </figure>
                  ))}
                </div>
              </div>

            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Formulario -->
    <section class="section bg-sand-50">
      <div class="container-site grid gap-12 lg:grid-cols-[1fr_1.3fr] lg:gap-16">
        <div>
          <p class="eyebrow">Escríbenos</p>
          <h2 class="title-section">¿Tienes alguna pregunta?</h2>
          <p class="lead">Completa el formulario y te respondemos a la brevedad.</p>

          <ul class="mt-8 space-y-3">
            <li class="flex items-center gap-3 text-sm text-ink-700"><Icon name="clock" class="h-5 w-5 text-brand-600" /> Respuesta en menos de 24 horas</li>
            <li class="flex items-center gap-3 text-sm text-ink-700"><Icon name="users" class="h-5 w-5 text-brand-600" /> Clases para todos los niveles</li>
            <li class="flex items-center gap-3 text-sm text-ink-700"><Icon name="sun" class="h-5 w-5 text-brand-600" /> Voleibol de playa en Lima</li>
          </ul>

          <div class="mt-10 border-t border-ink-200 pt-6">
            <p class="text-sm font-semibold text-ink-900">Síguenos en redes</p>
            <div class="mt-3 flex gap-3">
              <a href="https://www.instagram.com/arena_voleibolclub" target="_blank" rel="noopener noreferrer" class="btn-secondary !min-h-[40px] !px-4 !py-2">Instagram</a>
              <a href="https://www.facebook.com/p/Arena-voleibol-club-100092486123346/" target="_blank" rel="noopener noreferrer" class="btn-secondary !min-h-[40px] !px-4 !py-2">Facebook</a>
            </div>
          </div>
        </div>

        <div class="card p-6 sm:p-8">
          <form id="contactFormPage" class="grid gap-5" novalidate>
            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label for="cf-name" class="field-label">Nombre completo</label>
                <input type="text" id="cf-name" name="name" placeholder="Tu nombre" required autocomplete="name" class="field-input" />
              </div>
              <div>
                <label for="cf-email" class="field-label">Correo electrónico</label>
                <input type="email" id="cf-email" name="email" placeholder="tu@email.com" required autocomplete="email" class="field-input" />
              </div>
            </div>
            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label for="cf-phone" class="field-label">Teléfono <span class="font-normal text-ink-400">(opcional)</span></label>
                <input type="tel" id="cf-phone" name="phone" placeholder="+51 999 000 000" autocomplete="tel" class="field-input" />
              </div>
              <div>
                <label for="cf-interest" class="field-label">¿Qué te interesa?</label>
                <select id="cf-interest" name="interest" class="field-input">
                  <option value="">Selecciona una opción</option>
                  <option value="clases">Clases de voleibol</option>
                  <option value="clinicas">Clínicas y talleres</option>
                  <option value="torneos">Torneos</option>
                  <option value="otro">Otro</option>
                </select>
              </div>
            </div>
            <div>
              <label for="cf-message" class="field-label">Mensaje</label>
              <textarea id="cf-message" name="message" rows="5" placeholder="Cuéntanos qué necesitas…" required class="field-input resize-y"></textarea>
            </div>
            <div>
              <button type="submit" class="btn-primary w-full sm:w-auto" id="form-submit-btn">
                <span class="btn-text">Enviar mensaje</span>
                <Icon name="send" class="h-4 w-4" />
              </button>
            </div>
          </form>

          <div id="form-success" class="hidden py-8 text-center" role="status">
            <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-success-50 text-success-600"><Icon name="check" class="h-6 w-6" /></span>
            <h3 class="mt-4 text-xl font-bold">¡Mensaje enviado!</h3>
            <p class="mt-2 text-sm text-ink-500">Gracias por escribirnos. Te contactaremos pronto.</p>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  // ── Tabs ──
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll<HTMLButtonElement>('.sede-tab');
    const panels = document.querySelectorAll<HTMLElement>('.sede-panel');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const targetId = tab.dataset.tab;
        tabs.forEach(t => { t.classList.remove('active'); t.setAttribute('aria-selected', 'false'); t.tabIndex = -1; });
        panels.forEach(p => p.classList.add('hidden'));
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');
        tab.tabIndex = 0;
        document.getElementById(`panel-${targetId}`)?.classList.remove('hidden');
      });
    });

    // ── Contact Form ──
    const form = document.getElementById('contactFormPage') as HTMLFormElement | null;
    const successDiv = document.getElementById('form-success');
    const submitBtn = document.getElementById('form-submit-btn') as HTMLButtonElement | null;

    // Load EmailJS
    const ejsScript = document.createElement('script');
    ejsScript.src = 'https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js';
    ejsScript.onload = () => {
      if ((window as any).emailjs) {
        (window as any).emailjs.init("dG-vxHRYY4yYtgoJn");
      }
    };
    document.head.appendChild(ejsScript);

    // Inline error helpers
    function showError(fieldId: string, msg: string) {
      clearError(fieldId);
      const field = document.getElementById(fieldId);
      if (!field) return;
      const err = document.createElement('span');
      err.className = 'field-error';
      err.textContent = msg;
      field.parentElement?.appendChild(err);
      field.classList.add('field-invalid');
    }
    function clearError(fieldId: string) {
      const field = document.getElementById(fieldId);
      field?.classList.remove('field-invalid');
      field?.parentElement?.querySelector('.field-error')?.remove();
    }
    function clearAllErrors() {
      form?.querySelectorAll('.field-error').forEach(el => el.remove());
      form?.querySelectorAll('.field-invalid').forEach(el => el.classList.remove('field-invalid'));
    }

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearAllErrors();

      const emailjs = (window as any).emailjs;
      if (!emailjs) {
        showError('cf-name', 'Servicio de email no disponible. Intenta más tarde.');
        return;
      }

      const fd = new FormData(form);
      const name    = (fd.get('name')     as string ?? '').trim();
      const email   = (fd.get('email')    as string ?? '').trim();
      const phone   = (fd.get('phone')    as string ?? '').trim();
      const interest = (fd.get('interest') as string ?? '').trim();
      const message = (fd.get('message')  as string ?? '').trim();

      let hasError = false;
      if (!name || name.length < 2) {
        showError('cf-name', 'Ingresa un nombre válido (mínimo 2 caracteres).');
        hasError = true;
      }
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        showError('cf-email', 'Ingresa un correo electrónico válido.');
        hasError = true;
      }
      if (!message || message.length < 10) {
        showError('cf-message', 'El mensaje debe tener al menos 10 caracteres.');
        hasError = true;
      }
      if (hasError) return;

      if (submitBtn) {
        submitBtn.disabled = true;
        const btnText = submitBtn.querySelector('.btn-text');
        if (btnText) btnText.textContent = 'Enviando…';
      }

      try {
        const result = await emailjs.send('service_fayk1hj', 'template_5e9osht', {
          from_name : name,
          reply_to  : email,
          phone     : phone || 'No proporcionado',
          interest  : interest || 'No especificado',
          message   : message,
        });

        if (result.text === 'OK') {
          form.classList.add('hidden');
          successDiv?.classList.remove('hidden');
        } else {
          throw new Error('Respuesta inesperada del servidor');
        }
      } catch (err) {
        console.error('EmailJS error:', err);
        showError('cf-message', 'Error al enviar. Por favor intenta nuevamente o escríbenos por WhatsApp.');
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          const btnText = submitBtn.querySelector('.btn-text');
          if (btnText) btnText.textContent = 'Enviar mensaje';
        }
      }
    });

    // Clear errors on input
    ['cf-name','cf-email','cf-message'].forEach(id => {
      document.getElementById(id)?.addEventListener('input', () => clearError(id));
    });
  });
</script>
<style>
  .sede-tab {
    min-height: 40px;
    border-radius: 9999px;
    padding: 0.5rem 1.25rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: #4B555D;
    transition: background-color 0.2s, color 0.2s;
  }
  .sede-tab:hover { color: #141A1F; }
  .sede-tab[aria-selected='true'] {
    background: #fff;
    color: #074863;
    box-shadow: 0 1px 2px rgb(20 26 31 / 0.08);
  }
  :global(.field-invalid) { border-color: #B42318 !important; }
  :global(.field-error) {
    display: block;
    margin-top: 0.35rem;
    font-size: 0.8rem;
    color: #B42318;
  }
</style>
