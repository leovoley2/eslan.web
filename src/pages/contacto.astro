---


<Layout title="Arena Voleibol club - contacto" description="Contactanos y comienza la diversión con el voleibol de playa">
   <!-- component -->
   <script>
    document.addEventListener('DOMContentLoaded', () => {
      const locationSelect = document.getElementById('locationSelect');
      const locationContainers = document.querySelectorAll('[id^="location-"]');
      const modal = document.getElementById('imageModal');
      const modalImage = document.getElementById('modalImage');
      const modalTitle = document.getElementById('modalTitle');
      const modalDescription = document.getElementById('modalDescription');
      const closeModal = document.getElementById('closeModal');
  
      locationSelect?.addEventListener('change', (e) => {
        const target = e.target as HTMLSelectElement;
        const selectedLocation = target.value;
        
        locationContainers.forEach(container => {
          container.classList.add('hidden');
        });
        
        document.getElementById(`location-${selectedLocation}`)?.classList.remove('hidden');
      });
  
      document.querySelectorAll('.gallery-image').forEach(image => {
        image.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLElement;
          if (modal && modalImage && modalTitle && modalDescription) {
            modalImage.setAttribute('src', target.dataset.image || '');
            modalTitle.textContent = target.dataset.title || '';
            modalDescription.textContent = target.dataset.description || '';
            modal.classList.remove('hidden');
          }
        });
      });
  
      closeModal?.addEventListener('click', () => {
        modal?.classList.add('hidden');
      });
    });
  </script>
  
  <div class="max-w-6xl mx-auto p-4 relative z-10 py-12">
    <h2 class="text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-arena-blue to-arena-dark text-center mb-8 drop-shadow-sm">Nuestras Sedes</h2>
    
    <div class="mb-12 flex flex-col items-center">
      <label for="locationSelect" class="block text-base font-bold text-arena-dark mb-3">
        Selecciona una sede
      </label>
      <select
        id="locationSelect"
        class="block w-full max-w-sm rounded-xl border border-white/60 bg-white/60 backdrop-blur-md shadow-inner focus:border-arena-cyan focus:ring-2 focus:ring-arena-cyan/30 text-gray-900 py-3 px-4 font-medium transition-all"
      >
        {locations.map(location => (
          <option value={location.id}>{location.name}</option>
        ))}
      </select>
    </div>
  
    {locations.map((location, index) => (
      <div id={`location-${location.id}`} class={index === 0 ? '' : 'hidden'}>
        <div class="grid md:grid-cols-2 gap-8 mb-12">
          <!-- Información y mapa -->
          <div class="bg-white/80 backdrop-blur-2xl rounded-3xl border border-white/60 shadow-xl overflow-hidden relative group">
            <div class="absolute inset-0 bg-gradient-to-br from-white/40 to-transparent pointer-events-none"></div>
            <div class="aspect-video w-full relative z-10 border-b border-gray-200">
              <iframe
                src={location.mapUrl}
                class="w-full h-full border-0"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
              ></iframe>
            </div>
            
            <div class="p-8 relative z-10">
              <h3 class="text-3xl font-bold mb-6 text-arena-blue drop-shadow-sm">{location.name}</h3>
              
              <div class="space-y-4 text-gray-800 font-medium">
                <div class="flex items-start gap-4">
                  <svg class="h-6 w-6 text-arena-cyan shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  <p>{location.address}</p>
                </div>
                
                <div class="flex items-center gap-4">
                  <svg class="h-6 w-6 text-arena-cyan shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                  <p>{location.phone}</p>
                </div>
                
                <div class="flex items-center gap-4">
                  <svg class="h-6 w-6 text-arena-cyan shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <p>{location.schedule}</p>
                </div>
                
                <div class="flex items-center gap-4">
                  <svg class="h-6 w-6 text-arena-cyan shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                  <p>{location.email}</p>
                </div>
              </div>
              
              <a 
                href={`https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(location.address)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-8 w-full inline-block text-center bg-gradient-to-r from-arena-cyan to-arena-blue text-white font-bold py-3 px-4 rounded-xl shadow-md hover:shadow-lg hover:-translate-y-1 active:scale-95 transition-all duration-300"
              >
                Cómo llegar
              </a>
            </div>
          </div>
  
          <!-- Galería de imágenes -->
          <div class="grid grid-cols-1 gap-6">
            {location.images.map(image => (
              <div
                class="gallery-image cursor-pointer overflow-hidden rounded-3xl border border-white/60 bg-white/40 shadow-[0_8px_32px_0_rgba(31,38,135,0.05)] transition-all duration-300 hover:scale-[1.03] hover:shadow-[0_8px_32px_0_rgba(78,178,229,0.2)] group"
                data-image={image.url}
                data-title={image.title}
                data-description={image.description}
              >
                <img
                  src={image.url}
                  alt={image.title}
                  class="w-full h-48 object-cover transition-transform duration-700 ease-in-out group-hover:scale-105"
                />
                <div class="p-5 bg-white/80 backdrop-blur-md border-t border-white/50 text-gray-900 border-t border-gray-100 relative z-10">
                  <h3 class="font-bold text-xl mb-1 text-arena-dark">{image.title}</h3>
                  <p class="text-gray-600 font-medium text-sm">{image.description}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    ))}
  
    <!-- Modal -->
    <div id="imageModal" style="display: none;" class="fixed inset-0 bg-black/80 backdrop-blur-md z-50 flex items-center justify-center p-4 transition-opacity">
      <div class="bg-white/95 backdrop-blur-2xl rounded-3xl border border-white/20 shadow-2xl max-w-4xl w-full overflow-hidden">
        <div class="p-4 border-b border-gray-200 flex justify-between items-center bg-white/50">
          <h3 id="modalTitle" class="text-2xl font-bold text-arena-dark"></h3>
          <button id="closeModal" class="text-gray-500 hover:text-arena-cyan hover:bg-gray-100 p-2 rounded-full transition-colors">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>
        <div class="p-6">
          <img id="modalImage" class="w-full rounded-2xl shadow-inner max-h-[70vh] object-contain bg-gray-50" src="" alt="" />
          <p id="modalDescription" class="mt-6 text-gray-800 font-medium text-lg text-center"></p>
        </div>
      </div>
    </div>
  </div>
   
</Layout>
<!-- component -->
