---

<Layout title="Arena Voleibol Club - Contacto" description="Contáctanos y comienza la diversión con el voleibol de playa. Sedes en Chorrillos y Surco." hideFooterForm={true}>

  <!-- ===== HERO ===== -->
  <section class="contact-hero">
    <div class="hero-bg-shapes">
      <div class="shape shape-1"></div>
      <div class="shape shape-2"></div>
      <div class="shape shape-3"></div>
    </div>
    <div class="hero-content">
      <span class="hero-badge">📍 Encuéntranos</span>
      <h1 class="hero-title">Hablemos de <span class="hero-accent">Voleibol</span></h1>
      <p class="hero-desc">Dos sedes listas para recibírtе. Elige la más cercana y únete a la comunidad Arena.</p>
    </div>
    <div class="hero-wave">
      <svg viewBox="0 0 1440 80" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
        <path d="M0,40 C360,80 1080,0 1440,40 L1440,80 L0,80 Z" fill="#f8f9fa"/>
      </svg>
    </div>
  </section>

  <!-- ===== SEDES TABS ===== -->
  <section class="sedes-section">
    <div class="container">

      <!-- Tab buttons -->
      <div class="sede-tabs" role="tablist">
        {locations.map((loc, i) => (
          <button
            class={`sede-tab ${i === 0 ? 'active' : ''}`}
            data-tab={loc.id}
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
          >
            <span class="tab-icon">🏐</span>
            <div>
              <span class="tab-name">{loc.name}</span>
              <span class="tab-sub">{loc.subtitle}</span>
            </div>
          </button>
        ))}
      </div>

      <!-- Tab panels -->
      {locations.map((loc, i) => (
        <div id={`panel-${loc.id}`} class={`sede-panel ${i !== 0 ? 'hidden' : ''}`} role="tabpanel">
          <div class="sede-grid">

            <!-- LEFT: Info + Map -->
            <div class="info-col">
              <div class="info-card">
                <div class="info-header">
                  <h2 class="info-name">{loc.name}</h2>
                  <span class="info-badge">{loc.subtitle}</span>
                </div>

                <ul class="info-list">
                  <li class="info-item">
                    <span class="info-icon">📍</span>
                    <div>
                      <span class="info-label">Dirección</span>
                      <span class="info-value">{loc.address}</span>
                    </div>
                  </li>
                  <li class="info-item">
                    <span class="info-icon">📞</span>
                    <div>
                      <span class="info-label">Teléfono</span>
                      <a href={`tel:+51${loc.phone.replace(/\s/g,'')}`} class="info-link">{loc.phone}</a>
                    </div>
                  </li>
                  <li class="info-item">
                    <span class="info-icon">🕐</span>
                    <div>
                      <span class="info-label">Horario</span>
                      <span class="info-value">{loc.schedule}</span>
                    </div>
                  </li>
                  <li class="info-item">
                    <span class="info-icon">✉️</span>
                    <div>
                      <span class="info-label">Email</span>
                      <a href={`mailto:${loc.email}`} class="info-link">{loc.email}</a>
                    </div>
                  </li>
                </ul>

                <div class="info-actions">
                  <a href={loc.mapDir} target="_blank" rel="noopener noreferrer" class="btn-primary">
                    <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
                    Cómo llegar
                  </a>
                  <a href={loc.whatsapp} target="_blank" rel="noopener noreferrer" class="btn-whatsapp">
                    <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.124.549 4.122 1.514 5.857L.042 23.25A.75.75 0 00.75 24h.033l5.519-1.444A11.936 11.936 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.75a9.716 9.716 0 01-4.946-1.352l-.354-.211-3.67.961.978-3.572-.23-.368A9.713 9.713 0 012.25 12C2.25 6.615 6.615 2.25 12 2.25S21.75 6.615 21.75 12 17.385 21.75 12 21.75z" fill-rule="evenodd" clip-rule="evenodd"/></svg>
                    WhatsApp
                  </a>
                </div>
              </div>

              <!-- Map -->
              <div class="map-card">
                <iframe
                  src={loc.mapEmbed}
                  class="map-iframe"
                  allowfullscreen=""
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                  title={`Mapa ${loc.name}`}
                ></iframe>
              </div>
            </div>

            <!-- RIGHT: Gallery + Form -->
            <div class="right-col">
              <!-- Gallery -->
              <div class="gallery-grid">
                {loc.images.map((img, idx) => (
                  <div class={`gallery-item ${idx === 0 ? 'gallery-featured' : ''}`}>
                    <img src={img.url} alt={img.label} loading="lazy" />
                    <div class="gallery-overlay">
                      <span>{img.label}</span>
                    </div>
                  </div>
                ))}
              </div>
            </div>

          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ===== CONTACT FORM ===== -->
  <section class="form-section">
    <div class="container">
      <div class="form-wrapper">
        <div class="form-left">
          <span class="section-badge">💬 Escríbenos</span>
          <h2 class="form-title">¿Tienes alguna<br/><span class="accent">pregunta?</span></h2>
          <p class="form-desc">Completa el formulario y te respondemos a la brevedad.</p>

          <ul class="contact-quick">
            <li>
              <span class="q-icon">⚡</span>
              <span>Respuesta en menos de 24 horas</span>
            </li>
            <li>
              <span class="q-icon">🏐</span>
              <span>Clases para todos los niveles</span>
            </li>
            <li>
              <span class="q-icon">🌊</span>
              <span>Voleibol de playa en Lima</span>
            </li>
          </ul>
        </div>

        <div class="form-right">
          <form id="contactFormPage" class="contact-form" novalidate>
            <div class="form-row">
              <div class="form-group">
                <label for="cf-name">Nombre completo</label>
                <input type="text" id="cf-name" name="name" placeholder="Tu nombre" required autocomplete="name"/>
              </div>
              <div class="form-group">
                <label for="cf-email">Correo electrónico</label>
                <input type="email" id="cf-email" name="email" placeholder="tu@email.com" required autocomplete="email"/>
              </div>
            </div>
            <div class="form-group">
              <label for="cf-phone">Teléfono (opcional)</label>
              <input type="tel" id="cf-phone" name="phone" placeholder="+51 999 000 000" autocomplete="tel"/>
            </div>
            <div class="form-group">
              <label for="cf-interest">¿En qué estás interesado?</label>
              <select id="cf-interest" name="interest">
                <option value="">Selecciona una opción</option>
                <option value="clases">Clases de voleibol</option>
                <option value="clinicas">Clínicas y talleres</option>
                <option value="torneos">Torneos</option>
                <option value="otro">Otro</option>
              </select>
            </div>
            <div class="form-group">
              <label for="cf-message">Mensaje</label>
              <textarea id="cf-message" name="message" rows="4" placeholder="Cuéntanos más sobre lo que necesitas..." required></textarea>
            </div>
            <button type="submit" class="form-submit" id="form-submit-btn">
              <span class="btn-text">Enviar mensaje</span>
              <svg class="btn-arrow" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
            </button>
          </form>
          <div id="form-success" class="form-success hidden">
            <span class="success-icon">✅</span>
            <h3>¡Mensaje enviado!</h3>
            <p>Gracias por escribirnos. Te contactaremos pronto.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== SOCIAL CTA ===== -->
  <section class="social-section">
    <div class="container">
      <div class="social-card">
        <div class="social-text">
          <h3>Síguenos en redes</h3>
          <p>Mira nuestros entrenamientos, torneos y mucho más</p>
        </div>
        <div class="social-links">
          <a href="https://www.instagram.com/arena_voleibolclub" target="_blank" rel="noopener noreferrer" class="social-btn instagram">
            <svg width="22" height="22" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
            Instagram
          </a>
          <a href="https://www.facebook.com/p/Arena-voleibol-club-100092486123346/" target="_blank" rel="noopener noreferrer" class="social-btn facebook">
            <svg width="22" height="22" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            Facebook
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>

<script>
  // ── Tabs ──
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll<HTMLButtonElement>('.sede-tab');
    const panels = document.querySelectorAll<HTMLElement>('.sede-panel');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const targetId = tab.dataset.tab;
        tabs.forEach(t => { t.classList.remove('active'); t.setAttribute('aria-selected', 'false'); });
        panels.forEach(p => p.classList.add('hidden'));
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');
        document.getElementById(`panel-${targetId}`)?.classList.remove('hidden');
      });
    });

    // ── Contact Form ──
    const form = document.getElementById('contactFormPage') as HTMLFormElement | null;
    const successDiv = document.getElementById('form-success');
    const submitBtn = document.getElementById('form-submit-btn') as HTMLButtonElement | null;

    // Load EmailJS
    const ejsScript = document.createElement('script');
    ejsScript.src = 'https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js';
    ejsScript.onload = () => {
      if ((window as any).emailjs) {
        (window as any).emailjs.init("dG-vxHRYY4yYtgoJn");
      }
    };
    document.head.appendChild(ejsScript);

    // Inline error helpers
    function showError(fieldId: string, msg: string) {
      clearError(fieldId);
      const field = document.getElementById(fieldId);
      if (!field) return;
      const err = document.createElement('span');
      err.className = 'field-error';
      err.textContent = msg;
      field.parentElement?.appendChild(err);
      field.classList.add('field-invalid');
    }
    function clearError(fieldId: string) {
      const field = document.getElementById(fieldId);
      field?.classList.remove('field-invalid');
      field?.parentElement?.querySelector('.field-error')?.remove();
    }
    function clearAllErrors() {
      form?.querySelectorAll('.field-error').forEach(el => el.remove());
      form?.querySelectorAll('.field-invalid').forEach(el => el.classList.remove('field-invalid'));
    }

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearAllErrors();

      const emailjs = (window as any).emailjs;
      if (!emailjs) {
        showError('cf-name', 'Servicio de email no disponible. Intenta más tarde.');
        return;
      }

      const fd = new FormData(form);
      const name    = (fd.get('name')     as string ?? '').trim();
      const email   = (fd.get('email')    as string ?? '').trim();
      const phone   = (fd.get('phone')    as string ?? '').trim();
      const interest = (fd.get('interest') as string ?? '').trim();
      const message = (fd.get('message')  as string ?? '').trim();

      let hasError = false;
      if (!name || name.length < 2) {
        showError('cf-name', 'Ingresa un nombre válido (mínimo 2 caracteres).');
        hasError = true;
      }
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        showError('cf-email', 'Ingresa un correo electrónico válido.');
        hasError = true;
      }
      if (!message || message.length < 10) {
        showError('cf-message', 'El mensaje debe tener al menos 10 caracteres.');
        hasError = true;
      }
      if (hasError) return;

      if (submitBtn) {
        submitBtn.disabled = true;
        const btnText = submitBtn.querySelector('.btn-text');
        if (btnText) btnText.textContent = 'Enviando…';
      }

      try {
        const result = await emailjs.send('service_fayk1hj', 'template_5e9osht', {
          from_name : name,
          reply_to  : email,
          phone     : phone || 'No proporcionado',
          interest  : interest || 'No especificado',
          message   : message,
        });

        if (result.text === 'OK') {
          form.classList.add('hidden');
          successDiv?.classList.remove('hidden');
        } else {
          throw new Error('Respuesta inesperada del servidor');
        }
      } catch (err) {
        console.error('EmailJS error:', err);
        showError('cf-message', 'Error al enviar. Por favor intenta nuevamente o escríbenos por WhatsApp.');
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          const btnText = submitBtn.querySelector('.btn-text');
          if (btnText) btnText.textContent = 'Enviar mensaje';
        }
      }
    });

    // Clear errors on input
    ['cf-name','cf-email','cf-message'].forEach(id => {
      document.getElementById(id)?.addEventListener('input', () => clearError(id));
    });
  });
</script>

<style>
/* =======================================
   VARIABLES & BASE
======================================= */
:root {
  --navy: #01577a;
  --navy-dark: #023d55;
  --amber: #ffb919;
  --amber-light: #ffd166;
  --white: #ffffff;
  --gray-50: #f8f9fa;
  --gray-100: #f1f3f5;
  --gray-400: #adb5bd;
  --gray-600: #6c757d;
  --gray-800: #343a40;
  --radius-lg: 1.5rem;
  --radius-xl: 2rem;
  --shadow-md: 0 4px 24px rgba(1,87,122,0.10);
  --shadow-lg: 0 8px 40px rgba(1,87,122,0.15);
}

.container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 1.5rem;
}

/* =======================================
   HERO
======================================= */
.contact-hero {
  position: relative;
  background: linear-gradient(135deg, var(--navy-dark) 0%, var(--navy) 60%, #025f88 100%);
  padding: 8rem 1.5rem 5rem;
  overflow: hidden;
  text-align: center;
}

.hero-bg-shapes { position: absolute; inset: 0; pointer-events: none; }
.shape {
  position: absolute;
  border-radius: 50%;
  background: rgba(255,185,25,0.08);
}
.shape-1 { width: 500px; height: 500px; top: -200px; right: -150px; }
.shape-2 { width: 300px; height: 300px; bottom: -100px; left: -80px; background: rgba(255,255,255,0.04); }
.shape-3 { width: 200px; height: 200px; top: 50%; right: 25%; transform: translateY(-50%); }

.hero-content { position: relative; z-index: 2; }

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  background: rgba(255,185,25,0.15);
  border: 1px solid rgba(255,185,25,0.3);
  color: var(--amber);
  padding: 0.4rem 1rem;
  border-radius: 999px;
  font-size: 0.85rem;
  font-weight: 600;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  margin-bottom: 1.5rem;
}

.hero-title {
  font-size: clamp(2.2rem, 5vw, 3.8rem);
  font-weight: 900;
  color: var(--white);
  line-height: 1.1;
  margin-bottom: 1rem;
  letter-spacing: -0.02em;
}
.hero-accent { color: var(--amber); }

.hero-desc {
  font-size: 1.1rem;
  color: rgba(255,255,255,0.75);
  max-width: 520px;
  margin: 0 auto;
  line-height: 1.7;
}

.hero-wave {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  line-height: 0;
}
.hero-wave svg { width: 100%; height: 70px; display: block; }

/* =======================================
   SEDES SECTION
======================================= */
.sedes-section {
  background: var(--gray-50);
  padding: 4rem 0 5rem;
}

/* Tabs */
.sede-tabs {
  display: flex;
  gap: 1rem;
  margin-bottom: 2.5rem;
  flex-wrap: wrap;
}

.sede-tab {
  display: flex;
  align-items: center;
  gap: 0.8rem;
  padding: 0.8rem 1.5rem;
  border-radius: var(--radius-lg);
  border: 2px solid transparent;
  background: var(--white);
  cursor: pointer;
  transition: all 0.25s ease;
  box-shadow: var(--shadow-md);
  text-align: left;
}
.sede-tab:hover {
  border-color: var(--navy);
  transform: translateY(-2px);
}
.sede-tab.active {
  background: var(--navy);
  border-color: var(--navy);
  box-shadow: 0 8px 24px rgba(1,87,122,0.3);
}
.tab-icon { font-size: 1.4rem; }
.tab-name {
