---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';

const objetivos = [
  { titulo: 'Desarrollo técnico', texto: 'Perfeccionar las técnicas individuales en cada fundamento del juego.' },
  { titulo: 'Mejora física', texto: 'Aumentar la resistencia, agilidad y fuerza específica para la arena.' },
  { titulo: 'Táctica de juego', texto: 'Desarrollar estrategias eficaces en ataque y en defensa.' },
  { titulo: 'Trabajo en equipo', texto: 'Fomentar la comunicación y colaboración entre compañeros.' },
  { titulo: 'Diversión y motivación', texto: 'Un ambiente positivo que te motive a seguir mejorando.' },
];

const clinicas = [
  {
    nombre: 'Saque',
    objetivo: 'Perfeccionar la técnica de saque, mejorando precisión y potencia.',
    metas: 'Un saque consistente y efectivo, adaptado a distintas situaciones de juego.',
    beneficios: 'Más efectividad en el servicio y control del juego desde el inicio.',
  },
  {
    nombre: 'Recepción',
    objetivo: 'Mejorar la recepción y el pase, base para construir una jugada ofensiva.',
    metas: 'Más precisión en la recepción y control de balones difíciles.',
    beneficios: 'Mejor transición de defensa a ataque y menos errores no forzados.',
  },
  {
    nombre: 'Ataque',
    objetivo: 'Optimizar el remate, enfocándose en la potencia y la colocación del golpe.',
    metas: 'Un remate poderoso y preciso, capaz de superar bloqueos y defensas.',
    beneficios: 'Más puntos y mayor variedad en el ataque.',
  },
  {
    nombre: 'Bloqueo',
    objetivo: 'Perfeccionar el bloqueo para neutralizar los ataques del oponente.',
    metas: 'Más efectividad en la red y estrategias para distintos tipos de remate.',
    beneficios: 'Mejor defensa en la red y control del juego defensivo.',
  },
  {
    nombre: 'Defensa',
    objetivo: 'Mejorar la defensa en la arena, con foco en velocidad y agilidad.',
    metas: 'Mejor respuesta ante remates y saques, y capacidad de recuperación.',
    beneficios: 'Un juego defensivo sólido, más resistencia y rapidez.',
  },
];

const whatsapp = 'https://wa.me/51929418895?text=Hola,%20quiero%20informaci%C3%B3n%20sobre%20las%20cl%C3%ADnicas';
---

<Layout title="Clínicas · Arena Voleibol Club" description="Clínicas de voleibol de playa por fundamento técnico en Lima: saque, recepción, ataque, bloqueo y defensa.">
  <PageHeader
    eyebrow="Clínicas"
    title="Clínicas por fundamento técnico"
    description="Sesiones enfocadas en un fundamento a la vez para que mejores rápido y con detalle. Inscripciones abiertas todo el año."
    image="/7.jpg"
  >
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href={whatsapp} target="_blank" rel="noopener noreferrer" class="btn-accent">
        Consultar fechas <Icon name="arrow-right" class="h-4 w-4" />
      </a>
      <a href="#fundamentos" class="btn-outline-light">Ver clínicas</a>
    </div>
  </PageHeader>

  <main>
    <section class="section bg-white">
      <div class="container-site grid gap-10 lg:grid-cols-2 lg:items-center lg:gap-16">
        <div class="aspect-[4/3] overflow-hidden rounded-xl bg-sand-100">
          <img src="/clinica.jpg" alt="Clínica de vóley playa en Arena Voleibol Club" loading="lazy" class="h-full w-full object-cover" />
        </div>
        <div>
          <p class="eyebrow">Objetivos</p>
          <h2 class="title-section">Una formación integral</h2>
          <ul class="mt-8 space-y-5">
            {objetivos.map((o) => (
              <li class="flex gap-3">
                <Icon name="check" class="mt-0.5 h-5 w-5 flex-none text-brand-600" />
                <p class="text-sm leading-relaxed text-ink-600">
                  <span class="font-semibold text-ink-900">{o.titulo}.</span> {o.texto}
                </p>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section id="fundamentos" class="section bg-sand-50">
      <div class="container-site">
        <div class="max-w-2xl">
          <p class="eyebrow">Fundamentos</p>
          <h2 class="title-section">Elige la clínica que necesitas</h2>
          <p class="lead">Adaptamos cada sesión al nivel de los participantes para asegurar una progresión continua.</p>
        </div>

        <div class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {clinicas.map((c) => (
            <article class="card flex flex-col p-6 sm:p-7" data-animate>
              <h3 class="text-lg font-bold">Clínica de {c.nombre.toLowerCase()}</h3>
              <dl class="mt-5 space-y-4 text-sm leading-relaxed">
                <div>
                  <dt class="font-semibold text-ink-900">Objetivo</dt>
                  <dd class="mt-0.5 text-ink-500">{c.objetivo}</dd>
                </div>
                <div>
                  <dt class="font-semibold text-ink-900">Metas</dt>
                  <dd class="mt-0.5 text-ink-500">{c.metas}</dd>
                </div>
                <div>
                  <dt class="font-semibold text-ink-900">Beneficios</dt>
                  <dd class="mt-0.5 text-ink-500">{c.beneficios}</dd>
                </div>
              </dl>
            </article>
          ))}

          <article class="flex flex-col justify-between rounded-xl bg-brand-800 p-6 sm:p-7">
            <div>
              <h3 class="text-lg font-bold text-white">¿Por qué nuestras clínicas?</h3>
              <ul class="mt-5 space-y-3 text-sm text-white/75">
                <li class="flex gap-2.5"><Icon name="check" class="mt-0.5 h-4 w-4 flex-none text-accent-400" /> Entrenadores expertos en vóley playa</li>
                <li class="flex gap-2.5"><Icon name="check" class="mt-0.5 h-4 w-4 flex-none text-accent-400" /> Enfoque personalizado por nivel</li>
                <li class="flex gap-2.5"><Icon name="check" class="mt-0.5 h-4 w-4 flex-none text-accent-400" /> Ambiente seguro y motivador</li>
                <li class="flex gap-2.5"><Icon name="check" class="mt-0.5 h-4 w-4 flex-none text-accent-400" /> Red de contactos con jugadores y coaches</li>
              </ul>
            </div>
            <a href={whatsapp} target="_blank" rel="noopener noreferrer" class="btn-accent mt-8 w-full">Consultar información</a>
          </article>
        </div>
      </div>
    </section>

    <section class="section bg-white">
      <div class="container-site">
        <div class="grid gap-4 sm:grid-cols-3">
          <div class="aspect-[4/5] overflow-hidden rounded-xl bg-sand-100"><img src="/andra-guille.jpg" alt="Jugadoras del club en la arena" loading="lazy" class="h-full w-full object-cover" /></div>
          <div class="aspect-[4/5] overflow-hidden rounded-xl bg-sand-100"><img src="/voleo.jpg" alt="Jugadora realizando un voleo" loading="lazy" class="h-full w-full object-cover" /></div>
          <div class="aspect-[4/5] overflow-hidden rounded-xl bg-sand-100"><img src="/clinica2.jpg" alt="Entrenamiento grupal de clínica" loading="lazy" class="h-full w-full object-cover" /></div>
        </div>
        <div class="mt-10 max-w-2xl">
          <h2 class="title-section !mt-0">Inscripciones abiertas todo el año</h2>
          <p class="lead">
            Aprovecha nuestras promociones para nuevos inscritos y grupos. Escríbenos y te contamos las próximas fechas.
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href={whatsapp} target="_blank" rel="noopener noreferrer" class="btn-primary">Consultar fechas</a>
            <a href="/contacto" class="btn-secondary">Ir a contacto</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
