---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';

const beneficios = [
  {
    nombre: 'Salud cardiovascular',
    descripcion: 'Un ejercicio completo que fortalece tu corazón, mejora la circulación y aumenta tu resistencia.',
    icono: 'heart',
  },
  {
    nombre: 'Fuerza y tonicidad',
    descripcion: 'La arena ofrece una resistencia natural que fortalece piernas, glúteos y abdomen de forma segura.',
    icono: 'bolt',
  },
  {
    nombre: 'Quema de calorías',
    descripcion: 'Moverte en la arena puede quemar hasta 600 calorías por hora. Una forma divertida de cuidar tu peso.',
    icono: 'fire',
  },
  {
    nombre: 'Coordinación y agilidad',
    descripcion: 'Los movimientos explosivos y cambios de dirección mejoran tus reflejos, equilibrio y control corporal.',
    icono: 'target',
  },
  {
    nombre: 'Bienestar mental',
    descripcion: 'Jugar al aire libre y bajo el sol reduce el estrés y la ansiedad, y mejora tu estado de ánimo.',
    icono: 'sun',
  },
  {
    nombre: 'Bajo impacto articular',
    descripcion: 'La arena absorbe el impacto y protege rodillas y tobillos: puedes entrenar intenso y seguro.',
    icono: 'shield',
  },
] as const;
---

<Layout title="Aprende jugando · Arena Voleibol Club" description="Descubre los beneficios físicos y mentales del voleibol de playa y empieza a entrenar en Lima.">
  <PageHeader
    eyebrow="Aprende jugando"
    title="Más que un deporte, un estilo de vida"
    description="Jugar vóley playa no solo mejora tu técnica: transforma tu salud física y mental."
    image="/antebrazo.jpg"
  />

  <main>
    <section class="section bg-white">
      <div class="container-site">
        <div class="max-w-2xl">
          <p class="eyebrow">Beneficios</p>
          <h2 class="title-section">Lo que la arena hace por ti</h2>
        </div>

        <dl class="mt-12 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
          {beneficios.map((b) => (
            <div class="flex gap-4" data-animate>
              <span class="icon-tile"><Icon name={b.icono} /></span>
              <div>
                <dt class="font-display text-base font-bold text-ink-900">{b.nombre}</dt>
                <dd class="mt-1.5 text-sm leading-relaxed text-ink-500">{b.descripcion}</dd>
              </div>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section class="section bg-sand-50">
      <div class="container-site grid gap-10 lg:grid-cols-2 lg:items-center lg:gap-16">
        <div>
          <p class="eyebrow">¿Por qué la arena?</p>
          <h2 class="title-section">Un desafío que engancha</h2>
          <div class="mt-5 space-y-4 text-base leading-relaxed text-ink-600">
            <p>
              Jugar sobre la arena pone a prueba tu físico y te conecta con el aire libre, el mar y el sol. Es un deporte de comunicación constante y trabajo en equipo.
            </p>
            <p>
              En Arena Voleibol Club te damos la bienvenida sin importar tu nivel. Siempre hay un lugar para ti en la cancha.
            </p>
          </div>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href="/#reservas" class="btn-primary">Reservar clase <Icon name="arrow-right" class="h-4 w-4" /></a>
            <a href="/niveles" class="btn-secondary">Conocer mi nivel</a>
          </div>
        </div>
        <div class="aspect-[4/3] overflow-hidden rounded-xl bg-sand-100 lg:aspect-[5/6]">
          <img src="/lidia.png" alt="Equipo de Arena Voleibol Club en la playa después de un entrenamiento." loading="lazy" class="h-full w-full object-cover" />
        </div>
      </div>
    </section>
  </main>
</Layout>
