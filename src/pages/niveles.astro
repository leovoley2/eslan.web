---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';

const niveles = [
  {
    id: 'beginner0',
    numero: 0,
    nombre: 'Iniciación 0',
    etiqueta: 'Principiante absoluto',
    progreso: 10,
    descripcion: ['No tengo experiencia en voleibol indoor ni de playa; juego eventualmente. Me he inscrito en alguna academia pero no duré mucho, y no logro hacer tres toques seguidos de dedos o antebrazo.'],
    objetivos: ['Aprender fundamentos básicos', 'Desarrollar coordinación', 'Familiarizarse con las reglas'],
    resumen: ['Sin experiencia', 'Aprendiendo reglas', 'Coordinación básica'],
  },
  {
    id: 'beginner1',
    numero: 1,
    nombre: 'Iniciación 1',
    etiqueta: 'Fundamentos básicos',
    progreso: 30,
    descripcion: ['Entreno voleibol desde hace meses y juego eventualmente con amigos. Conozco las reglas básicas, tengo dominio técnico de los fundamentos y puedo completar una jugada de 3 toques.'],
    objetivos: ['Perfeccionar la técnica básica', 'Desarrollar jugadas de 3 toques', 'Mejorar la coordinación en equipo'],
    resumen: ['Fundamentos básicos', '3 toques seguidos', 'Reglas conocidas'],
  },
  {
    id: 'intermediate',
    numero: 2,
    nombre: 'Intermedio',
    etiqueta: 'Técnica desarrollada',
    progreso: 60,
    descripcion: ['Domino el servicio y controlo la recepción del saque dirigiéndola al centro de la cancha. Domino el ataque y coloco la bola en el campo contrario. Sé acercarme a mi compañero cuando recibe para que el juego fluya.'],
    objetivos: ['Dominar servicios variados', 'Mejorar la colocación estratégica', 'Desarrollar juego táctico'],
    resumen: ['Servicio controlado', 'Ataques básicos', 'Táctica inicial'],
  },
  {
    id: 'intermediate1',
    numero: 3,
    nombre: 'Intermedio 1',
    etiqueta: 'Técnica avanzada',
    progreso: 80,
    descripcion: [
      'Domino distintos tipos de ataque: fuerte, pokey, palmeo, cut (toque corto) y over (por encima del bloqueo).',
      'Juego con bloqueo y sé salir del bloqueo; conozco sus señas.',
      'Uso el viento y el sol a mi favor y defiendo balones a una mano.',
    ],
    objetivos: ['Dominar múltiples tipos de ataque', 'Perfeccionar el bloqueo', 'Adaptarse a las condiciones ambientales'],
    resumen: ['Múltiples ataques', 'Bloqueo avanzado', 'Adaptación ambiental'],
  },
  {
    id: 'advanced',
    numero: 4,
    nombre: 'Avanzado',
    etiqueta: 'Nivel competitivo',
    progreso: 95,
    descripcion: ['Domino el servicio en salto o de potencia y tengo una correcta aproximación al ataque. Conozco las fases del juego (K1 y K2), me ubico en defensa según la señal del bloqueo y sé qué golpe hacer con un bloqueo delante.'],
    objetivos: ['Dominar servicios de potencia', 'Perfeccionar las fases de juego', 'Preparación competitiva'],
    resumen: ['Servicio de potencia', 'Fases de juego', 'Nivel competitivo'],
  },
];
---

<Layout title="Niveles · Arena Voleibol Club" description="Descubre tu nivel de juego en voleibol de playa con nuestra evaluación rápida y conoce qué trabajarás en cada etapa.">
  <PageHeader
    eyebrow="Niveles de juego"
    title="Conoce tu nivel. Es tu momento."
    description="Nuestros entrenadores evalúan el nivel de cada participante para darte una mejor asesoría y corregir tus puntos débiles con un entrenamiento planificado."
  >
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <button id="startQuiz" type="button" class="btn-primary">
        Hacer evaluación rápida <Icon name="arrow-right" class="h-4 w-4" />
      </button>
      <a href="/#reservas" class="btn-secondary">Reservar clase</a>
    </div>
    <p class="mt-3 text-sm text-ink-400">5 preguntas · menos de 1 minuto</p>
  </PageHeader>

  <!-- Evaluación rápida -->
  <div id="quizModal" class="fixed inset-0 z-[60] hidden items-center justify-center bg-ink-900/70 p-4" role="dialog" aria-modal="true" aria-labelledby="quizTitle">
    <div class="max-h-[90vh] w-full max-w-xl overflow-y-auto rounded-xl bg-white shadow-xl">
      <div class="flex items-center justify-between border-b border-ink-100 px-6 py-4">
        <h2 id="quizTitle" class="text-lg font-bold">Evaluación rápida de nivel</h2>
        <button id="closeQuiz" type="button" class="-mr-2 flex h-10 w-10 items-center justify-center rounded-full text-ink-400 hover:bg-ink-50 hover:text-ink-800" aria-label="Cerrar evaluación">
          <Icon name="close" class="h-5 w-5" />
        </button>
      </div>

      <div class="p-6">
        <div id="quizContent">
          <div class="mb-6">
            <div class="h-1.5 w-full overflow-hidden rounded-full bg-ink-100">
              <div id="progressBar" class="h-full rounded-full bg-brand-600 transition-all duration-300" style="width: 0%"></div>
            </div>
            <p class="mt-2 text-sm text-ink-500">Pregunta <span id="currentQuestion">1</span> de <span id="totalQuestions">5</span></p>
          </div>

          <div id="questionContainer" class="mb-6"></div>
          <p id="quizError" class="mb-4 hidden text-sm text-danger-600" role="alert">Selecciona una respuesta para continuar.</p>

          <div class="flex justify-between gap-3">
            <button id="prevQuestion" type="button" class="btn-secondary" disabled>Anterior</button>
            <button id="nextQuestion" type="button" class="btn-primary">Siguiente</button>
          </div>
        </div>

        <div id="quizResult" class="hidden text-center" role="status">
          <div id="resultIcon" class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-brand-50 font-display text-2xl font-extrabold text-brand-700"></div>
          <p class="mt-5 text-sm text-ink-500">Tu nivel recomendado</p>
          <h3 id="resultTitle" class="mt-1 text-2xl font-extrabold"></h3>
          <p id="resultDescription" class="mx-auto mt-3 max-w-sm text-sm leading-relaxed text-ink-500"></p>
          <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
            <button id="viewLevels" type="button" class="btn-secondary">Ver detalles del nivel</button>
            <a href="/#reservas" class="btn-primary">Reservar clase</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <main>
    <section class="section bg-white">
      <div class="container-site">
        <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
          <div class="max-w-2xl">
            <p class="eyebrow">Niveles de entrenamiento</p>
            <h2 class="title-section">¿En qué etapa estás?</h2>
            <p class="lead">Descubre qué habilidades desarrollarás en cada nivel.</p>
          </div>
          <button id="toggleComparison" type="button" class="btn-secondary flex-none" aria-controls="comparisonView" aria-expanded="false">
            <Icon name="chart" class="h-4 w-4" /> <span>Comparar niveles</span>
          </button>
        </div>

        <!-- Comparación -->
        <div id="comparisonView" class="mt-10 hidden">
          <div class="overflow-x-auto rounded-xl border border-ink-100">
            <table class="w-full min-w-[640px] text-left text-sm">
              <thead class="bg-sand-50">
                <tr>
                  {niveles.map((n) => (
                    <th scope="col" class="px-4 py-3 font-semibold text-ink-900">
                      <span class="text-ink-400">{n.numero} ·</span> {n.nombre}
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody class="divide-y divide-ink-100">
                {[0, 1, 2].map((fila) => (
                  <tr>
                    {niveles.map((n) => <td class="px-4 py-3 text-ink-600">{n.resumen[fila]}</td>)}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Lista de niveles -->
        <div id="levelsContainer" class="mt-10 divide-y divide-ink-100 overflow-hidden rounded-xl border border-ink-100">
          {niveles.map((n) => (
            <div class="level-card bg-white transition-colors duration-500" data-level={n.id}>
              <button
                type="button"
                class="level-header flex w-full items-center gap-4 px-5 py-5 text-left transition-colors hover:bg-sand-50 sm:px-6"
                aria-expanded="false"
                aria-controls={`nivel-${n.id}`}
                onclick="toggleLevel(this)"
              >
                <span class="flex h-10 w-10 flex-none items-center justify-center rounded-full bg-brand-50 font-display text-base font-extrabold text-brand-700">{n.numero}</span>
                <span class="min-w-0 flex-1">
                  <span class="block font-display text-base font-bold text-ink-900 sm:text-lg">Nivel {n.nombre}</span>
                  <span class="mt-2 flex items-center gap-3">
                    <span class="h-1.5 w-full max-w-[220px] overflow-hidden rounded-full bg-ink-100">
                      <span class="block h-full rounded-full bg-brand-600" style={`width: ${n.progreso}%`}></span>
                    </span>
                    <span class="hidden whitespace-nowrap text-sm text-ink-500 sm:inline">{n.etiqueta}</span>
                  </span>
                </span>
                <span class="chevron flex-none text-ink-400 transition-transform duration-300"><Icon name="chevron-down" class="h-5 w-5" /></span>
              </button>

              <div id={`nivel-${n.id}`} class="level-content max-h-0 overflow-hidden transition-[max-height] duration-500">
                <div class="grid gap-6 px-5 pb-6 sm:px-6 md:grid-cols-[1.4fr_1fr] md:pl-[4.75rem]">
                  <div class="space-y-2 text-sm leading-relaxed text-ink-600">
                    <p class="text-xs font-semibold uppercase tracking-eyebrow text-ink-400">Así juegas</p>
                    {n.descripcion.map((d) => <p>{d}</p>)}
                  </div>
                  <div>
                    <p class="text-xs font-semibold uppercase tracking-eyebrow text-ink-400">Objetivos del nivel</p>
                    <ul class="mt-2 space-y-2">
                      {n.objetivos.map((o) => (
                        <li class="flex gap-2 text-sm text-ink-700">
                          <Icon name="check" class="mt-0.5 h-4 w-4 flex-none text-brand-600" /> {o}
                        </li>
                      ))}
                    </ul>
                    <a href="/#reservas" class="link-arrow mt-5">Reservar clase de este nivel <Icon name="arrow-right" class="h-4 w-4" /></a>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
    // Preguntas de la evaluación y puntaje por nivel
    const quizQuestions = [
        {
            question: "¿Cuál es tu experiencia previa con el voleibol?",
            answers: [
                { text: "Nunca he jugado voleibol", points: { beginner0: 3, beginner1: 0, intermediate: 0, intermediate1: 0, advanced: 0 } },
                { text: "He jugado ocasionalmente con amigos", points: { beginner0: 1, beginner1: 2, intermediate: 0, intermediate1: 0, advanced: 0 } },
                { text: "He tomado clases por algunos meses", points: { beginner0: 0, beginner1: 3, intermediate: 1, intermediate1: 0, advanced: 0 } },
                { text: "Entreno regularmente hace más de un año", points: { beginner0: 0, beginner1: 0, intermediate: 2, intermediate1: 3, advanced: 1 } },
                { text: "Juego de forma competitiva", points: { beginner0: 0, beginner1: 0, intermediate: 0, intermediate1: 1, advanced: 3 } }
            ]
        },
        {
            question: "¿Puedes completar una secuencia de 3 toques seguidos?",
            answers: [
                { text: "No, me es muy difícil", points: { beginner0: 3, beginner1: 0, intermediate: 0, intermediate1: 0, advanced: 0 } },
                { text: "A veces, pero no consistentemente", points: { beginner0: 1, beginner1: 3, intermediate: 0, intermediate1: 0, advanced: 0 } },
                { text: "Sí, la mayoría de las veces", points: { beginner0: 0, beginner1: 1, intermediate: 3, intermediate1: 1, advanced: 0 } },
                { text: "Siempre, y con diferentes técnicas", points: { beginner0: 0, beginner1: 0, intermediate: 1, intermediate1: 3, advanced: 2 } },
                { text: "Perfectamente, con estrategia", points: { beginner0: 0, beginner1: 0, intermediate: 0, intermediate1: 1, advanced: 3 } }
            ]
        },
        {
            question: "¿Qué tan bien conoces las reglas del voleibol?",
            answers: [
                { text: "No conozco las reglas básicas", points: { beginner0: 3, beginner1: 0, intermediate: 0, intermediate1: 0, advanced: 0 } },
                { text: "Conozco algunas reglas básicas", points: { beginner0: 1, beginner1: 3, intermediate: 1, intermediate1: 0, advanced: 0 } },
                { text: "Conozco bien las reglas principales", points: { beginner0: 0, beginner1: 1, intermediate: 3, intermediate1: 1, advanced: 0 } },
                { text: "Conozco reglas avanzadas y señas", points: { beginner0: 0, beginner1: 0, intermediate: 1, intermediate1: 3, advanced: 2 } },
                { text: "Domino completamente las reglas y fases de juego", points: { beginner0: 0, beginner1: 0, intermediate: 0, intermediate1: 1, advanced: 3 } }
            ]
        },
        {
            question: "¿Cómo describirías tu servicio?",
            answers: [
                { text: "No puedo servir consistentemente", points: { beginner0: 3, beginner1: 1, intermediate: 0, intermediate1: 0, advanced: 0 } },
                { text: "Sirvo por debajo, a veces pasa", points: { beginner0: 1, beginner1: 3, intermediate: 0, intermediate1: 0, advanced: 0 } },
                { text: "Sirvo por arriba con control", points: { beginner0: 0, beginner1: 1, intermediate: 3, intermediate1: 1, advanced: 0 } },
                { text: "Manejo diferentes tipos de servicio", points: { beginner0: 0, beginner1: 0, intermediate: 1, intermediate1: 3, advanced: 1 } },
                { text: "Domino servicio en salto y de potencia", points: { beginner0: 0, beginner1: 0, intermediate: 0, intermediate1: 1, advanced: 3 } }
            ]
        },
        {
            question: "¿Qué tan cómodo te sientes con el bloqueo y la defensa?",
            answers: [
                { text: "No sé bloquear ni defender", points: { beginner0: 3, beginner1: 1, intermediate: 0, intermediate1: 0, advanced: 0 } },
                { text: "Puedo hacer defensas básicas", points: { beginner0: 1, beginner1: 3, intermediate: 1, intermediate1: 0, advanced: 0 } },
                { text: "Bloqueo ocasionalmente y defiendo decentemente", points: { beginner0: 0, beginner1: 1, intermediate: 3, intermediate1: 1, advanced: 0 } },
                { text: "Manejo bloqueo con señas y defensas a una mano", points: { beginner0: 0, beginner1: 0, intermediate: 1, intermediate1: 3, advanced: 1 } },
                { text: "Domino bloqueo estratégico y defensa posicional", points: { beginner0: 0, beginner1: 0, intermediate: 0, intermediate1: 1, advanced: 3 } }
            ]
        }
    ];

    const levelDescriptions = {
        beginner0: { title: "Nivel de Iniciación 0", icon: "0", description: "Perfecto para comenzar desde cero. Te ayudaremos a desarrollar los fundamentos básicos." },
        beginner1: { title: "Nivel de Iniciación 1", icon: "1", description: "Ya tienes una base. Vamos a perfeccionar tu técnica y consistencia." },
        intermediate: { title: "Nivel Intermedio", icon: "2", description: "Tienes buen control. Es hora de desarrollar estrategia y técnicas avanzadas." },
        intermediate1: { title: "Nivel Intermedio 1", icon: "3", description: "Excelente nivel técnico. Perfeccionemos tu juego táctico y competitivo." },
        advanced: { title: "Nivel Avanzado", icon: "4", description: "Eres un jugador experimentado. Preparémonos para la competición." }
    };

    let currentQuestionIndex = 0;
    let userAnswers: number[] = [];
    let recommendedLevel = '';

    const quizModal = document.getElementById('quizModal');
    const startQuizBtn = document.getElementById('startQuiz');

    function openQuiz() {
        if (!quizModal) return;
        quizModal.classList.remove('hidden');
        quizModal.classList.add('flex');
        document.body.style.overflow = 'hidden';
        showQuestion(0);
    }

    function closeQuiz() {
        if (!quizModal) return;
        quizModal.classList.add('hidden');
        quizModal.classList.remove('flex');
        document.body.style.overflow = '';
        resetQuiz();
        startQuizBtn?.focus();
    }

    startQuizBtn?.addEventListener('click', openQuiz);
    document.getElementById('closeQuiz')?.addEventListener('click', closeQuiz);
    quizModal?.addEventListener('click', (e) => { if (e.target === quizModal) closeQuiz(); });
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && quizModal && !quizModal.classList.contains('hidden')) closeQuiz();
    });

    document.getElementById('nextQuestion')?.addEventListener('click', () => {
        const selected = document.querySelector<HTMLInputElement>('input[name="answer"]:checked');
        const error = document.getElementById('quizError');
        if (!selected) {
            error?.classList.remove('hidden');
            return;
        }
        error?.classList.add('hidden');
        userAnswers[currentQuestionIndex] = parseInt(selected.value);

        if (currentQuestionIndex < quizQuestions.length - 1) {
            showQuestion(currentQuestionIndex + 1);
        } else {
            showResult();
        }
    });

    document.getElementById('questionContainer')?.addEventListener('change', () => {
        document.getElementById('quizError')?.classList.add('hidden');
    });

    document.getElementById('prevQuestion')?.addEventListener('click', () => {
        if (currentQuestionIndex > 0) showQuestion(currentQuestionIndex - 1);
    });

    document.getElementById('viewLevels')?.addEventListener('click', () => {
        const level = recommendedLevel;
        closeQuiz();

        // Abre y resalta el nivel recomendado
        const levelCard = document.querySelector<HTMLElement>(`[data-level="${level}"]`);
        if (!levelCard) return;
        const header = levelCard.querySelector<HTMLElement>('.level-header');
        if (header && header.getAttribute('aria-expanded') !== 'true') toggleLevel(header);
        levelCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
        levelCard.classList.add('!bg-accent-50');
        setTimeout(() => levelCard.classList.remove('!bg-accent-50'), 2000);
    });

    const toggleComparisonBtn = document.getElementById('toggleComparison');
    toggleComparisonBtn?.addEventListener('click', () => {
        const comparisonView = document.getElementById('comparisonView');
        const label = toggleComparisonBtn.querySelector('span');
        if (!comparisonView) return;
        const willShow = comparisonView.classList.contains('hidden');
        comparisonView.classList.toggle('hidden', !willShow);
        toggleComparisonBtn.setAttribute('aria-expanded', String(willShow));
        if (label) label.textContent = willShow ? 'Ocultar comparación' : 'Comparar niveles';
    });

    function showQuestion(index: number) {
        currentQuestionIndex = index;
        const question = quizQuestions[index];
        const container = document.getElementById('questionContainer');

        if (container) {
            container.innerHTML = `
                <fieldset>
                    <legend class="mb-4 font-display text-lg font-bold text-ink-900">${question.question}</legend>
                    <div class="space-y-2">
                        ${question.answers.map((answer, i) => `
                            <label class="flex cursor-pointer items-center gap-3 rounded-lg border border-ink-200 px-4 py-3 text-sm text-ink-700 transition-colors hover:border-ink-300 has-[:checked]:border-brand-600 has-[:checked]:bg-brand-50">
                                <input type="radio" name="answer" value="${i}" class="h-4 w-4 accent-[#01577A]" ${userAnswers[index] === i ? 'checked' : ''}>
                                <span>${answer.text}</span>
                            </label>
                        `).join('')}
                    </div>
                </fieldset>
            `;
        }

        const progressBar = document.getElementById('progressBar');
        if (progressBar) progressBar.style.width = ((index + 1) / quizQuestions.length) * 100 + '%';

        const currentQuestionEl = document.getElementById('currentQuestion');
        if (currentQuestionEl) currentQuestionEl.textContent = (index + 1).toString();

        const totalQuestionsEl = document.getElementById('totalQuestions');
        if (totalQuestionsEl) totalQuestionsEl.textContent = quizQuestions.length.toString();

        const prevBtn = document.getElementById('prevQuestion') as HTMLButtonElement | null;
        if (prevBtn) prevBtn.disabled = index === 0;

        const nextBtn = document.getElementById('nextQuestion');
        if (nextBtn) nextBtn.textContent = index === quizQuestions.length - 1 ? 'Ver resultado' : 'Siguiente';

        document.getElementById('quizError')?.classList.add('hidden');
    }

    function showResult() {
        const scores: Record<string, number> = { beginner0: 0, beginner1: 0, intermediate: 0, intermediate1: 0, advanced: 0 };

        userAnswers.forEach((answerIndex, questionIndex) => {
            const answer = quizQuestions[questionIndex].answers[answerIndex];
            Object.entries(answer.points).forEach(([level, points]) => { scores[level] += points; });
        });

        recommendedLevel = Object.keys(scores).reduce((a, b) => scores[a] > scores[b] ? a : b);
        const levelInfo = levelDescriptions[recommendedLevel as keyof typeof levelDescriptions];

        document.getElementById('quizContent')?.classList.add('hidden');
        document.getElementById('quizResult')?.classList.remove('hidden');

        const resultIcon = document.getElementById('resultIcon');
        const resultTitle = document.getElementById('resultTitle');
        const resultDescription = document.getElementById('resultDescription');
        if (resultIcon) resultIcon.textContent = levelInfo.icon;
        if (resultTitle) resultTitle.textContent = levelInfo.title;
        if (resultDescription) resultDescription.textContent = levelInfo.description;
    }

    function resetQuiz() {
        currentQuestionIndex = 0;
        userAnswers = [];
        document.getElementById('quizContent')?.classList.remove('hidden');
        document.getElementById('quizResult')?.classList.add('hidden');
    }

    // Acordeón de niveles
    function toggleLevel(header: HTMLElement) {
        const card = header.closest('.level-card');
        if (!card) return;
        const content = card.querySelector<HTMLElement>('.level-content');
        const chevron = header.querySelector<HTMLElement>('.chevron');
        const isOpen = header.getAttribute('aria-expanded') === 'true';

        document.querySelectorAll('.level-card').forEach(otherCard => {
            if (otherCard === card) return;
            const otherContent = otherCard.querySelector<HTMLElement>('.level-content');
            const otherChevron = otherCard.querySelector<HTMLElement>('.chevron');
            otherCard.querySelector('.level-header')?.setAttribute('aria-expanded', 'false');
            if (otherContent) otherContent.style.maxHeight = '0px';
            if (otherChevron) otherChevron.style.transform = 'rotate(0deg)';
        });

        if (!content || !chevron) return;
        header.setAttribute('aria-expanded', String(!isOpen));
        content.style.maxHeight = isOpen ? '0px' : content.scrollHeight + 'px';
        chevron.style.transform = isOpen ? 'rotate(0deg)' : 'rotate(180deg)';
    }

    (window as any).toggleLevel = toggleLevel;
</script>
