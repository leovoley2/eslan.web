<script>
    // Quiz questions and answers
    const quizQuestions = [
        {
            question: "¿Cuál es tu experiencia previa con el voleibol?",
            answers: [
                { text: "Nunca he jugado voleibol", points: { beginner0: 3, beginner1: 0, intermediate: 0, intermediate1: 0, advanced: 0 } },
                { text: "He jugado ocasionalmente con amigos", points: { beginner0: 1, beginner1: 2, intermediate: 0, intermediate1: 0, advanced: 0 } },
                { text: "He tomado clases por algunos meses", points: { beginner0: 0, beginner1: 3, intermediate: 1, intermediate1: 0, advanced: 0 } },
                { text: "Entreno regularmente hace más de un año", points: { beginner0: 0, beginner1: 0, intermediate: 2, intermediate1: 3, advanced: 1 } },
                { text: "Juego de forma competitiva", points: { beginner0: 0, beginner1: 0, intermediate: 0, intermediate1: 1, advanced: 3 } }
            ]
        },
        {
            question: "¿Puedes completar una secuencia de 3 toques seguidos?",
            answers: [
                { text: "No, me es muy difícil", points: { beginner0: 3, beginner1: 0, intermediate: 0, intermediate1: 0, advanced: 0 } },
                { text: "A veces, pero no consistentemente", points: { beginner0: 1, beginner1: 3, intermediate: 0, intermediate1: 0, advanced: 0 } },
                { text: "Sí, la mayoría de las veces", points: { beginner0: 0, beginner1: 1, intermediate: 3, intermediate1: 1, advanced: 0 } },
                { text: "Siempre, y con diferentes técnicas", points: { beginner0: 0, beginner1: 0, intermediate: 1, intermediate1: 3, advanced: 2 } },
                { text: "Perfectamente, con estrategia", points: { beginner0: 0, beginner1: 0, intermediate: 0, intermediate1: 1, advanced: 3 } }
            ]
        },
        {
            question: "¿Qué tan bien conoces las reglas del voleibol?",
            answers: [
                { text: "No conozco las reglas básicas", points: { beginner0: 3, beginner1: 0, intermediate: 0, intermediate1: 0, advanced: 0 } },
                { text: "Conozco algunas reglas básicas", points: { beginner0: 1, beginner1: 3, intermediate: 1, intermediate1: 0, advanced: 0 } },
                { text: "Conozco bien las reglas principales", points: { beginner0: 0, beginner1: 1, intermediate: 3, intermediate1: 1, advanced: 0 } },
                { text: "Conozco reglas avanzadas y señas", points: { beginner0: 0, beginner1: 0, intermediate: 1, intermediate1: 3, advanced: 2 } },
                { text: "Domino completamente las reglas y fases de juego", points: { beginner0: 0, beginner1: 0, intermediate: 0, intermediate1: 1, advanced: 3 } }
            ]
        },
        {
            question: "¿Cómo describirías tu servicio?",
            answers: [
                { text: "No puedo servir consistentemente", points: { beginner0: 3, beginner1: 1, intermediate: 0, intermediate1: 0, advanced: 0 } },
                { text: "Sirvo por debajo, a veces pasa", points: { beginner0: 1, beginner1: 3, intermediate: 0, intermediate1: 0, advanced: 0 } },
                { text: "Sirvo por arriba con control", points: { beginner0: 0, beginner1: 1, intermediate: 3, intermediate1: 1, advanced: 0 } },
                { text: "Manejo diferentes tipos de servicio", points: { beginner0: 0, beginner1: 0, intermediate: 1, intermediate1: 3, advanced: 1 } },
                { text: "Domino servicio en salto y de potencia", points: { beginner0: 0, beginner1: 0, intermediate: 0, intermediate1: 1, advanced: 3 } }
            ]
        },
        {
            question: "¿Qué tan cómodo te sientes con el bloqueo y la defensa?",
            answers: [
                { text: "No sé bloquear ni defender", points: { beginner0: 3, beginner1: 1, intermediate: 0, intermediate1: 0, advanced: 0 } },
                { text: "Puedo hacer defensas básicas", points: { beginner0: 1, beginner1: 3, intermediate: 1, intermediate1: 0, advanced: 0 } },
                { text: "Bloqueo ocasionalmente y defiendo decentemente", points: { beginner0: 0, beginner1: 1, intermediate: 3, intermediate1: 1, advanced: 0 } },
                { text: "Manejo bloqueo con señas y defensas a una mano", points: { beginner0: 0, beginner1: 0, intermediate: 1, intermediate1: 3, advanced: 1 } },
                { text: "Domino bloqueo estratégico y defensa posicional", points: { beginner0: 0, beginner1: 0, intermediate: 0, intermediate1: 1, advanced: 3 } }
            ]
        }
    ];

    const levelDescriptions = {
        beginner0: {
            title: "Nivel de Iniciación 0",
            icon: "🏐",
            description: "Perfecto para comenzar desde cero. Te ayudaremos a desarrollar los fundamentos básicos."
        },
        beginner1: {
            title: "Nivel de Iniciación 1", 
            icon: "⭐",
            description: "Ya tienes una base. Vamos a perfeccionar tu técnica y consistencia."
        },
        intermediate: {
            title: "Nivel Intermedio",
            icon: "🔥",
            description: "Tienes buen control. Es hora de desarrollar estrategia y técnicas avanzadas."
        },
        intermediate1: {
            title: "Nivel Intermedio 1",
            icon: "💪",
            description: "Excelente nivel técnico. Perfeccionemos tu juego táctico y competitivo."
        },
        advanced: {
            title: "Nivel Avanzado",
            icon: "🏆",
            description: "Eres un jugador experimentado. Preparémonos para la competición."
        }
    };

    let currentQuestionIndex = 0;
    let userAnswers = [];

    // Modal functionality
    document.addEventListener('DOMContentLoaded', function() {
        const startQuizBtn = document.getElementById('startQuiz');
        const closeQuizBtn = document.getElementById('closeQuiz');
        const quizModal = document.getElementById('quizModal');

        if (startQuizBtn) {
            startQuizBtn.addEventListener('click', function() {
                if (quizModal) {
                    quizModal.classList.remove('hidden');
                    quizModal.classList.add('flex');
                    showQuestion(0);
                }
            });
        }

        if (closeQuizBtn) {
            closeQuizBtn.addEventListener('click', function() {
                if (quizModal) {
                    quizModal.classList.add('hidden');
                    quizModal.classList.remove('flex');
                    resetQuiz();
                }
            });
        }

        // Quiz navigation
        const nextBtn = document.getElementById('nextQuestion');
        const prevBtn = document.getElementById('prevQuestion');

        if (nextBtn) {
            nextBtn.addEventListener('click', function() {
                const selectedAnswer = document.querySelector('input[name="answer"]:checked');
                if (!selectedAnswer) {
                    alert('Por favor selecciona una respuesta');
                    return;
                }

                userAnswers[currentQuestionIndex] = parseInt((selectedAnswer as HTMLInputElement).value);

                if (currentQuestionIndex < quizQuestions.length - 1) {
                    showQuestion(currentQuestionIndex + 1);
                } else {
                    showResult();
                }
            });
        }

        if (prevBtn) {
            prevBtn.addEventListener('click', function() {
                if (currentQuestionIndex > 0) {
                    showQuestion(currentQuestionIndex - 1);
                }
            });
        }

        // Level comparison
        const toggleComparisonBtn = document.getElementById('toggleComparison');
        if (toggleComparisonBtn) {
            toggleComparisonBtn.addEventListener('click', function() {
                const comparisonView = document.getElementById('comparisonView');
                if (comparisonView) {
                    const isVisible = !comparisonView.classList.contains('hidden');
                    
                    if (isVisible) {
                        comparisonView.classList.add('hidden');
                        this.textContent = '📊 Comparar Niveles';
                    } else {
                        comparisonView.classList.remove('hidden');
                        this.textContent = '📋 Ver Lista Detallada';
                        comparisonView.scrollIntoView({ behavior: 'smooth' });
                    }
                }
            });
        }

        // Animate cards on load
        const levelCards = document.querySelectorAll('.level-card');
        levelCards.forEach((card, index) => {
            const htmlCard = card as HTMLElement;
            htmlCard.style.opacity = '0';
            htmlCard.style.transform = 'translateY(20px)';
            setTimeout(() => {
                htmlCard.style.transition = 'all 0.6s ease';
                htmlCard.style.opacity = '1';
                htmlCard.style.transform = 'translateY(0)';
            }, index * 100);
        });
    });

    // Quiz functionality
    function showQuestion(index) {
        currentQuestionIndex = index;
        const question = quizQuestions[index];
        const container = document.getElementById('questionContainer');
        
        if (container) {
            container.innerHTML = `
                <h4 class="text-lg font-semibold text-gray-800 mb-4">${question.question}</h4>
                <div class="space-y-3">
                    ${question.answers.map((answer, i) => `
                        <label class="flex items-center p-3 border rounded-lg cursor-pointer hover:bg-gray-50 transition-colors">
                            <input type="radio" name="answer" value="${i}" class="mr-3">
                            <span>${answer.text}</span>
                        </label>
                    `).join('')}
                </div>
            `;
        }

        // Update progress
        const progressBar = document.getElementById('progressBar');
        if (progressBar) {
            const progress = ((index + 1) / quizQuestions.length) * 100;
            (progressBar as HTMLElement).style.width = progress + '%';
        }

        const currentQuestionEl = document.getElementById('currentQuestion');
        if (currentQuestionEl) {
            currentQuestionEl.textContent = (index + 1).toString();
        }

        const totalQuestionsEl = document.getElementById('totalQuestions');
        if (totalQuestionsEl) {
            totalQuestionsEl.textContent = quizQuestions.length.toString();
        }

        // Update navigation buttons
        const prevBtn = document.getElementById('prevQuestion') as HTMLButtonElement;
        if (prevBtn) {
            prevBtn.disabled = index === 0;
        }

        const nextBtn = document.getElementById('nextQuestion');
        if (nextBtn) {
            nextBtn.textContent = index === quizQuestions.length - 1 ? 'Finalizar' : 'Siguiente';
        }
    }

    function showResult() {
        // Calculate scores
        const scores = { beginner0: 0, beginner1: 0, intermediate: 0, intermediate1: 0, advanced: 0 };
        
        userAnswers.forEach((answerIndex, questionIndex) => {
            const answer = quizQuestions[questionIndex].answers[answerIndex];
            Object.keys(answer.points).forEach(level => {
                scores[level] += answer.points[level];
            });
        });

        // Find highest score
        const recommendedLevel = Object.keys(scores).reduce((a, b) => scores[a] > scores[b] ? a : b);
        const levelInfo = levelDescriptions[recommendedLevel];

        // Show result
        const quizContent = document.getElementById('quizContent');
        const quizResult = document.getElementById('quizResult');
        
        if (quizContent) quizContent.classList.add('hidden');
        if (quizResult) quizResult.classList.remove('hidden');
        
        const resultIcon = document.getElementById('resultIcon');
        const resultTitle = document.getElementById('resultTitle');
        const resultDescription = document.getElementById('resultDescription');
        
        if (resultIcon) resultIcon.textContent = levelInfo.icon;
        if (resultTitle) resultTitle.textContent = levelInfo.title;
        if (resultDescription) resultDescription.textContent = levelInfo.description;

        const viewLevelsBtn = document.getElementById('viewLevels');
        if (viewLevelsBtn) {
            viewLevelsBtn.addEventListener('click', function() {
                const quizModal = document.getElementById('quizModal');
                if (quizModal) {
                    quizModal.classList.add('hidden');
                    quizModal.classList.remove('flex');
                }
                
                // Highlight recommended level
                const levelCard = document.querySelector(`[data-level="${recommendedLevel}"]`) as HTMLElement;
                if (levelCard) {
                    levelCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    levelCard.style.transform = 'scale(1.02)';
                    levelCard.style.boxShadow = '0 0 20px rgba(59, 130, 246, 0.5)';
                    setTimeout(() => {
                        levelCard.style.transform = '';
                        levelCard.style.boxShadow = '';
                    }, 2000);
                }
                
                resetQuiz();
            });
        }
    }

    function resetQuiz() {
        currentQuestionIndex = 0;
        userAnswers = [];
        const quizContent = document.getElementById('quizContent');
        const quizResult = document.getElementById('quizResult');
        
        if (quizContent) quizContent.classList.remove('hidden');
        if (quizResult) quizResult.classList.add('hidden');
    }

    // Level accordion functionality
    function toggleLevel(header) {
        const card = header.closest('.level-card');
        const content = card.querySelector('.level-content') as HTMLElement;
        const chevron = header.querySelector('.chevron') as HTMLElement;
        const isOpen = content.style.maxHeight && content.style.maxHeight !== '0px';

        // Close all other cards
        document.querySelectorAll('.level-card').forEach(otherCard => {
            if (otherCard !== card) {
                const otherContent = otherCard.querySelector('.level-content') as HTMLElement;
                const otherChevron = otherCard.querySelector('.chevron') as HTMLElement;
                if (otherContent) otherContent.style.maxHeight = '0px';
                if (otherChevron) otherChevron.style.transform = 'rotate(0deg)';
            }
        });

        // Toggle current card
        if (isOpen) {
            content.style.maxHeight = '0px';
            chevron.style.transform = 'rotate(0deg)';
        } else {
            content.style.maxHeight = content.scrollHeight + 'px';
            chevron.style.transform = 'rotate(180deg)';
        }
    }

    // Make function globally available
    (window as any).toggleLevel = toggleLevel;
</script>

