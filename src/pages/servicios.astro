---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';

const pilares360 = [
  {
    titulo: 'Potencia física inteligente',
    texto: 'Construimos atletas explosivos, ágiles y resistentes a lesiones, optimizados para el movimiento en la arena.',
    icono: 'bolt',
  },
  {
    titulo: 'Dominio técnico consolidado',
    texto: 'Usamos análisis en video para pulir cada fundamento hasta convertirlo en un movimiento instintivo y eficaz.',
    icono: 'video',
  },
  {
    titulo: 'Fortaleza cognitiva',
    texto: 'Entrenamos la toma de decisiones, la anticipación y el control emocional bajo presión.',
    icono: 'brain',
  },
] as const;

const otros = [
  {
    titulo: 'Clínicas intensivas y camps',
    texto: 'Para quienes buscan una inmersión total o mejorar una habilidad específica en un formato corto y de alto impacto.',
    href: '/clinicas',
    cta: 'Ver clínicas',
    imagen: '/clinica.jpg',
  },
  {
    titulo: 'Semillero de Arena (escolar)',
    texto: 'Programa formativo donde los más jóvenes aprenden valores, disciplina y el amor por el vóley playa en un ambiente divertido.',
    href: 'https://wa.me/51929418895?text=Hola,%20quiero%20inscribir%20a%20mi%20hijo/a%20en%20el%20Semillero%20de%20Arena',
    cta: 'Inscribir a mi hijo/a',
    imagen: '/9.jpg',
  },
];
---

<Layout title="Servicios · Arena Voleibol Club" description="Programa de alto rendimiento 360°, clínicas intensivas y programa escolar de vóley playa en Lima.">
  <PageHeader
    eyebrow="Servicios"
    title="Desata tu verdadero potencial en la arena"
    description="Nuestra metodología integral trabaja cada pilar de tu rendimiento: cuerpo, técnica y mente."
    image="/3.jpg"
  />

  <main>
    <section class="section bg-white">
      <div class="container-site">
        <div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-end">
          <div class="max-w-2xl">
            <p class="eyebrow">Programa principal</p>
            <h2 class="title-section">Alto rendimiento 360°</h2>
            <p class="lead">
              Ideal para jugadores que buscan competir y romper sus límites. Un sistema que integra cuerpo, técnica y mente para transformar tu juego.
            </p>
          </div>
          <a href="https://wa.me/51929418895?text=Hola,%20quiero%20solicitar%20una%20evaluaci%C3%B3n%20para%20el%20programa%20360" target="_blank" rel="noopener noreferrer" class="btn-primary">
            Solicitar evaluación <Icon name="arrow-right" class="h-4 w-4" />
          </a>
        </div>

        <ol class="mt-12 grid gap-4 md:grid-cols-3">
          {pilares360.map((p, i) => (
            <li class="card p-6 sm:p-8" data-animate>
              <div class="flex items-center justify-between">
                <span class="icon-tile"><Icon name={p.icono} /></span>
                <span class="font-display text-sm font-bold text-ink-300">0{i + 1}</span>
              </div>
              <h3 class="mt-6 text-lg font-bold">{p.titulo}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-500">{p.texto}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section bg-sand-50">
      <div class="container-site">
        <div class="max-w-2xl">
          <p class="eyebrow">Más programas</p>
          <h2 class="title-section">Formatos para cada objetivo</h2>
        </div>

        <div class="mt-12 grid gap-6 lg:grid-cols-2">
          {otros.map((s) => {
            const externo = s.href.startsWith('http');
            return (
              <article class="card flex flex-col overflow-hidden sm:flex-row" data-animate>
                <div class="aspect-[16/10] flex-none bg-sand-100 sm:aspect-auto sm:w-48">
                  <img src={s.imagen} alt="" loading="lazy" class="h-full w-full object-cover" />
                </div>
                <div class="flex flex-1 flex-col p-6">
                  <h3 class="text-lg font-bold">{s.titulo}</h3>
                  <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-500">{s.texto}</p>
                  <a href={s.href} class="link-arrow mt-5" {...(externo ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
                    {s.cta} <Icon name="arrow-right" class="h-4 w-4" />
                  </a>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>
  </main>
</Layout>
